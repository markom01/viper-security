---
const { brandName } = Astro.props;
import STRINGS from '../../config/strings';
import { ICONS } from '../../config/icons';
const s = STRINGS;
---
<div role="banner" class="navbar">
  <div class="content-wrapper">
    <div class="navbar-wrapper">
      <a href="/" class="logo-link" aria-label={s.nav.homeAria}>
        <span class="brand-text">{brandName}</span>
      </a>
      <nav role="navigation" class="nav-menu-wrapper">
        <ul role="list" class="nav-menu-list">
          <li class="nav-list-item nav-list-brand">
            <a href="/" class="logo-link" aria-label={s.nav.homeAria}>
              <span class="brand-text">{brandName}</span>
            </a>
          </li>
          <li class="nav-list-item"><a href="/" class="nav-link">{s.nav.home}</a></li>
          <li class="nav-list-item"><a href="/#about" class="nav-link">{s.nav.about}</a></li>
          <li class="nav-list-item"><a href="/#services" class="nav-link">{s.nav.services}</a></li>
          <li class="nav-list-item"><a href="/#fleet" class="nav-link">{s.nav.fleet}</a></li>
          <li class="nav-list-item"><a href="/#how-it-works" class="nav-link">{s.nav.howItWorks}</a></li>
          <li class="nav-list-item"><a href="/#pricing" class="nav-link">{s.nav.pricing}</a></li>
          <li class="nav-list-item desktop-button">
            <a href="/#contact" class="primary-button small">
              <div class="button-text">{s.nav.contact}</div>
              <span aria-hidden="true" class="button-arrow" set:html={ICONS.rightArrow} />
            </a>
          </li>
          <li class="nav-list-item tablet-mobile-button">
            <a href="/#contact" class="secondary-button">
              <div class="button-text">{s.nav.contact}</div>
              <span aria-hidden="true" class="button-arrow" set:html={ICONS.rightArrowPure} />
            </a>
          </li>
        </ul>
        <div class="close-menu-button" style="-webkit-user-select: text;" aria-label={s.nav.menuAria} role="button" tabindex="0" aria-haspopup="menu" aria-expanded="false">
          <div class="nav-close">
            <span aria-hidden="true" set:html={ICONS.cancel} />
          </div>
        </div>
      </nav>
      <div class="nav-buttons-wrapper">
        <div class="tablet-button">
          <a href="/#contact" class="primary-button small">
            <div class="button-text">{s.nav.contact}</div>
            <span aria-hidden="true" class="button-arrow" set:html={ICONS.rightArrow} />
          </a>
        </div>
        <div class="open-menu-button" style="-webkit-user-select: text;" aria-label={s.nav.menuAria} role="button" tabindex="0" aria-haspopup="menu" aria-expanded="false">
          <div class="nav-open">
            <div class="menu-line"></div><div class="menu-line"></div><div class="menu-line"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .brand-text {
    font-family: var(--font-families--accent-font);
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: var(--colors--gold);
    white-space: nowrap;
  }
  .nav-menu-list {
    list-style: none;
  }
  /* Mobile: nav overlay hidden by default */
  @media (max-width: 991px) {
    .nav-menu-wrapper {
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .navbar[data-nav-open] .nav-menu-wrapper {
      visibility: visible;
      opacity: 1;
    }
  }
  /* Desktop: nav inline, not overlay */
  @media (min-width: 992px) {
    .nav-menu-wrapper {
      position: static;
      min-width: auto;
      min-height: auto;
      background: transparent;
      padding: 0;
      overflow: visible;
      inset: auto;
      display: flex;
      align-items: center;
    }
    .nav-menu-list {
      flex-direction: row;
    }
    .nav-list-brand,
    .close-menu-button,
    .tablet-mobile-button {
      display: none !important;
    }
    .open-menu-button {
      display: none !important;
    }
  }
</style>
<script is:inline>
(function() {
  var navbar = document.querySelector('.navbar');
  if (!navbar) return;
  document.addEventListener('click', function(e) {
    if (e.target.closest('.open-menu-button')) {
      navbar.setAttribute('data-nav-open', '');
    }
    if (e.target.closest('.close-menu-button')) {
      navbar.removeAttribute('data-nav-open');
    }
    // Close menu when a nav link is tapped
    if (e.target.closest('.nav-link')) {
      navbar.removeAttribute('data-nav-open');
    }
  });
})();
</script>
