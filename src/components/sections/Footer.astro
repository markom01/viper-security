---
const { pageContent } = Astro.props;
const { brandName, tagline, phoneItaly, phoneSpain } = Astro.props;
import STRINGS from '../../config/strings';
const s = STRINGS;
const b = pageContent?.branding;
const thisYear = new Date().getFullYear();

const cleanPhone = (phone: string) => phone?.replace(/[\s+]/g, '') || '';
const phoneSep = s.footer.phoneSeparator;
---
<footer class="footer" role="contentinfo">
  <div class="content-wrapper">
    <div class="footer-content-wrapper">
      <div class="footer-middle">
        <div class="footer-text-wrapper">
          <a href="/" class="logo-link">
            <span class="brand-text">{brandName}</span>
          </a>
          <p class="pure-text">
            <a href={`https://wa.me/${cleanPhone(phoneItaly)}`} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${phoneItaly}`} class="phone-wa-link">{phoneItaly}</a>
            {phoneSep}
            <a href={`https://wa.me/${cleanPhone(phoneSpain)}`} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${phoneSpain}`} class="phone-wa-link">{phoneSpain}</a>
          </p>
          <!-- <div class="social-links-wrapper">
            <a href="https://x.com/" target="_blank" class="social-link" aria-label={s.footer.socialX}>
              <img src="/images/x-logo.svg" width="20" height="20" loading="eager" alt="" aria-hidden="true" />
            </a>
            <a href="https://www.tiktok.com/" target="_blank" class="social-link" aria-label={s.footer.socialTiktok}>
              <img src="/images/tiktok-logo.svg" loading="eager" alt="" aria-hidden="true" />
            </a>
            <a href="https://www.instagram.com/" target="_blank" class="social-link" aria-label={s.footer.socialInstagram}>
              <img src="/images/instagram-logo.svg" loading="eager" alt="" aria-hidden="true" />
            </a>
            <a href="https://www.whatsapp.com/" target="_blank" class="social-link" aria-label={s.footer.socialWhatsapp}>
              <img src="/images/whatsapp-logo.svg" loading="eager" alt="" aria-hidden="true" />
            </a>
          </div> -->
        </div>
        <div class="footer-links-wrapper">
          <div class="footer-links-column">
            <div class="footer-links-heading">{s.footer.pagesHeading}</div>
            <div class="footer-links">
              <a href="/" class="footer-link">{s.nav.home}</a>
              <a href="/#about" class="footer-link">{s.nav.about}</a>
              <a href="/#services" class="footer-link">{s.nav.services}</a>
              <a href="/#fleet" class="footer-link">{s.nav.fleet}</a>
              <a href="/#how-it-works" class="footer-link">{s.nav.howItWorks}</a>
              <a href="/#pricing" class="footer-link">{s.nav.pricing}</a>
              <a href="/#contact" class="footer-link">{s.nav.contact}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
<style>
  :root{--colors--gold-bright:#c8a04c}
  .footer-luxury-tagline {
    font-family: var(--font-families--accent-font);
    font-size: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--colors--gold-bright);
    margin-top: 6px;
  }
  .brand-text {
    font-family: var(--font-families--accent-font);
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: var(--colors--gold-bright);
    white-space: nowrap;
  }
  .footer-motto {
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--colors--slate);
    margin-top: 4px;
  }
  .phone-wa-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .phone-wa-link:hover,
  .phone-wa-link:focus-visible {
    color: var(--colors--gold-bright);
    text-decoration: underline;
  }
  .footer-link:hover{color:var(--colors--gold-bright)}
</style>
