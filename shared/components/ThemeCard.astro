---
/**
 * Shared component — re-themeable across sites.
 * References ONLY design tokens; never hardcodes colors/fonts/sizes.
 * Each consuming site defines tokens in its own :root (global.css).
 */
const { title, subtitle, image, price } = Astro.props;
---
<article class="tc-card" data-scroll-reveal>
  {image && <img src={image} alt={title || ''} class="tc-card__img" loading="lazy" />}
  <div class="tc-card__body">
    <h3 class="tc-card__title">{title}</h3>
    {subtitle && <p class="tc-card__subtitle">{subtitle}</p>}
    {price && <p class="tc-card__price">{price}</p>}
  </div>
</article>
<style>
  /* Token contract required by consumers:
     --tc--card-bg, --tc--card-border, --tc--card-title, --tc--card-text,
     --tc--card-price, --tc--radius, --tc--shadow, --tc--font */
  .tc-card {
    display: flex;
    flex-direction: column;
    background: var(--tc--card-bg, var(--colors--onyx, #111));
    border: 1px solid var(--tc--card-border, var(--colors--cloud, #333));
    border-radius: var(--tc--radius, 12px);
    box-shadow: var(--tc--shadow, none);
    overflow: hidden;
    font-family: var(--tc--font, var(--font-families--body-font, sans-serif));
    color: var(--tc--card-text, var(--colors--ivory, #eee));
  }
  .tc-card__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .tc-card__body { padding: 1.25rem; }
  .tc-card__title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-family: var(--tc--title-font, var(--font-families--title-font, inherit));
    color: var(--tc--card-title, var(--colors--gold, #fff));
  }
  .tc-card__subtitle { margin: 0 0 0.75rem; font-size: 0.95rem; color: var(--tc--card-text, var(--colors--ivory, #eee)); }
  .tc-card__price { margin: 0; font-size: 1.1rem; font-weight: 600; color: var(--tc--card-price, var(--colors--amber, #fff)); }
</style>