---
import type { PageContent, NavLink } from "../types";
import STRINGS from "../config/strings";
import { jsonEscape } from "../config/json-escape";
const s = STRINGS;
import Nav from "../components/sections/Nav.astro";
import Footer from "../components/sections/Footer.astro";
import DropdownMenu from "../components/sections/DropdownMenu.astro";
import Font from "astro/components/Font.astro";
import "../styles/global.css";
import "lenis/dist/lenis.css";
import { pwaInfo } from "virtual:pwa-info";

interface Props {
  pageContent?: PageContent;
  brandName?: string;
  subtitle?: string;
  navItems?: NavLink[];
  footerItems?: NavLink[];
  /** Social profiles for the footer (real handles per site). */
  social?: { icon: string; href: string; label: string }[];
  ctaLabel?: string;
  /** Emit `<meta name="robots" content="noindex,follow">` (soft-noindex pages). */
  noindex?: boolean;
  /** Open Graph locale tag — defaults to the shared STRINGS value (en_US). */
  ogLocale?: string;
  /** <link rel=preload as=image> for the LCP image (hero). Optional. */
  preloadImage?: string;
}

const {
  pageContent,
  brandName,
  subtitle,
  navItems,
  footerItems,
  social,
  noindex,
  ogLocale,
  preloadImage,
} = Astro.props as Props;
// Explicit CMS labels take precedence; the layout never injects a hardcoded
// default button label. Site layouts pass ctaLabel explicitly (DBC: Get A
// Quote); VIPER reads its CMS `nav_contact` label here.
const ctaLabel =
  (Astro.props as Props).ctaLabel ?? pageContent?.labels?.["nav_contact"] ?? "";
const seo = pageContent?.seo;
const cmsJd = pageContent?.jsonld;
// Astro.site is always configured in both astro.configs (`site: site.url`).
const siteUrl = Astro.site!;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const bd = pageContent?.booking_data;
// Social image: CMS `seo.image` wins; fall back to the JSON-LD org logo so a
// site never emits zero og:image/twitter:image (orgLogo is only trusted as an
// absolute http(s) URL).
// Root relative `seo.image` at the serving origin, not the canonical siteUrl:
// in dev siteUrl points at prod, so rooting there fetches the image
// cross-origin (ERR_BLOCKED_BY_ORB) and defeats local preview. Absolute
// http(s) values pass through unchanged.
const ogImageUrl =
  (seo?.image
    ? seo.image.startsWith("http")
      ? seo.image
      : new URL(seo.image, Astro.url.origin)
    : null) ??
  (cmsJd?.org_logo?.startsWith("http") ? cmsJd.org_logo : null);
// Preload only root-relative og paths: they resolve against the SERVING host,
// so dev preview (localhost) and prod both fetch a same-origin, real file. An
// absolute `seo.image` (common when CMS fills a prod URL) or org_logo fallback
// would preload cross-origin in dev → ERR_BLOCKED_BY_ORB; skipping preload for
// those is harmless (it's just an optimization). Social metas keep the
// absolute ogImageUrl — scrapers need absolute.
const ogImagePath = seo?.image?.startsWith("/") ? seo.image : null;
const jd = {
  orgName: cmsJd?.org_name || cmsJd?.webSiteName,
  orgUrl: cmsJd?.org_url,
  orgLogo: cmsJd?.org_logo,
  orgDescription: cmsJd?.org_description,
  webSiteName: cmsJd?.webSiteName,
  webSiteUrl: cmsJd?.webSiteUrl,
  privacyPolicy: cmsJd?.privacy_policy,
  phoneItaly: cmsJd?.phoneItaly,
  phoneSpain: cmsJd?.phoneSpain,
  spainLocality: bd?.spain?.short_label,
  italyLocality: bd?.italy?.short_label,
  hasAddress: !!(bd?.spain?.short_label || bd?.italy?.short_label || false),
};
// JSON.stringify alone does NOT escape `<`, so a CMS-authored `</script>`
// would break out of the <script> element. `set:html` writes the value
// verbatim (no escaping). jsonEscape converts `<`, `>`, `&` and U+2028/U+2029
// to Unicode escapes that decode back to identical JSON — closing the raw-text
// `<script>` boundary while the strict CSP keeps script-src 'self'.
const addressJson = jd.hasAddress
  ? [
      {
        "@type": "PostalAddress",
        addressLocality: jd.spainLocality,
        addressCountry: "ES",
      },
      {
        "@type": "PostalAddress",
        addressLocality: jd.italyLocality,
        addressCountry: "IT",
      },
    ]
  : undefined;
const jdPhones = [jd.phoneSpain, jd.phoneItaly].filter(Boolean);
const jsonLdOrg = cmsJd?.org_name
  ? jsonEscape(
      JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: jd.orgName,
        url: jd.orgUrl,
        logo: jd.orgLogo,
        description: jd.orgDescription,
        ...(addressJson ? { address: addressJson } : {}),
        ...(jd.privacyPolicy ? { privacyPolicy: jd.privacyPolicy } : {}),
        ...(jdPhones.length ? { telephone: jdPhones } : {}),
      }),
    )
  : null;
const jsonLdWebSite = jsonEscape(
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: jd.webSiteName,
    url: jd.webSiteUrl,
    ...(jd.privacyPolicy ? { privacyPolicy: jd.privacyPolicy } : {}),
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <style>
      [tabindex="-1"]:focus-visible {
        outline: 2px solid var(--colors--amber);
        outline-offset: 2px;
      }
      :focus-visible {
        outline: 2px solid var(--colors--amber);
        outline-offset: 2px;
      }
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        z-index: 9999;
        padding: 12px 24px;
        background: var(--colors--onyx);
        color: var(--colors--amber);
        font-family: var(--font-families--body-font);
        font-size: 1rem;
        text-decoration: none;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
    <Font cssVariable="--font-families--body-font" />
    <Font cssVariable="--font-families--title-font" />
    <Font cssVariable="--font-families--accent-font" />
    <link href="/styles/theme.css" rel="stylesheet" />
    <title>{seo?.title}</title>
    {ogImagePath && !ogImagePath.endsWith(".svg") && (
      <link rel="preload" as="image" href={ogImagePath} />
    )}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <meta content={seo?.description} name="description" />
    {noindex && <meta content="noindex,follow" name="robots" />}
    <meta content={seo?.title} property="og:title" />
    <meta content={seo?.description} property="og:description" />
    {ogImageUrl && <meta content={ogImageUrl} property="og:image" />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={jd.orgName} />
    <meta property="og:locale" content={ogLocale ?? s.seo.ogLocale} />
    <meta content={seo?.title} name="twitter:title" />
    <meta content={seo?.description} name="twitter:description" />
    {ogImageUrl && <meta content={ogImageUrl} name="twitter:image" />}
    <meta property="og:type" content={s.seo.ogType} />
    <meta content={s.seo.twitterCard} name="twitter:card" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    {seo?.theme_color && <meta name="theme-color" content={seo?.theme_color} />}
    {
      pwaInfo?.webManifest?.linkTag && (
        <Fragment set:html={pwaInfo.webManifest.linkTag} />
      )
    }
    <script>
      import { registerSW } from "virtual:pwa-register";
      registerSW({ immediate: true });
    </script>
    <style>
      @font-face {
        font-family: "Fallback";
        size-adjust: 100%;
      }
      body {
        font-display: swap !important;
      }
    </style>
    <link href="/favicon.svg" rel="shortcut icon" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLdOrg && <script type="application/ld+json" set:html={jsonLdOrg} />}
    <script type="application/ld+json" set:html={jsonLdWebSite} />
  </head>
  <body>
    <Nav
      brandName={brandName ?? jd.orgName}
      pageContent={pageContent}
      navItems={navItems}
      ctaLabel={ctaLabel}
    />
    <DropdownMenu />
    <a href="#main-content" class="skip-link">{s.accessibility.skipLink}</a>
    <main id="main-content" class="page-wrapper" aria-label="Main content">
      <slot />
    </main>
    <Footer
      brandName={brandName ?? jd.orgName}
      pageContent={pageContent}
      footerItems={footerItems}
      social={social}
      phoneItaly={jd.phoneItaly}
      phoneSpain={jd.phoneSpain}
    />
    <script>
      import Lenis from "lenis";
      // Smooth scroll.
      new Lenis({
        autoRaf: true,
        autoToggle: true,
        anchors: { offset: 80 },
        allowNestedScroll: true,
      });
    </script>
    <script>
      // Import forces Astro to bundle this to an external /_astro/*.js module,
      // which the strict `script-src 'self'` CSP permits (no is:inline).
      import { initScrollReveal } from "../scripts/scroll-reveal";
      initScrollReveal();
    </script>
    <script>
      // Full-screen PhotoSwipe lightbox: any `a[data-lightbox]` (rendered by the
      // shared ZoomImage) opens a gallery grouped by its data-lightbox value.
      import "../scripts/lightbox";
    </script>
  </body>
</html>
