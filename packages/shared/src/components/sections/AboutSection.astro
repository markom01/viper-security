---
import type { PageContent } from "../../types";
import ZoomImage from "./ZoomImage.astro";
import ImageCarousel from "./ImageCarousel.astro";
interface Props {
  pageContent?: PageContent;
  /** Explicit carousel images — overrides pageContent.about.images when provided. Lets DBC service pages show 5 category-picked gallery images. */
  images?: string[];
}
const { pageContent, images: imagesProp } = Astro.props as Props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
import { ICONS } from "../../config/icons";
const s = resolveLabels(pageContent, STRINGS);
const about = pageContent?.about;
// Explicit prop wins; otherwise fall back to CMS about.images
const aboutGallery = imagesProp?.length ? imagesProp : about?.images?.length ? about.images : null;
---

<section id="about" class="section home-about-section">
  <div class="content-wrapper">
    <div class="home-about-content">
      <div data-scroll-reveal class="home-about-text-wrapper">
        <div class="about-heading">
          <div class="subheadline-wrapper">
            <div class="subheadline-line"></div>
            <div class="subheadline">{s.about.subheadline}</div>
          </div>
          <h2>{about?.heading}</h2>
        </div>
        <p>{about?.text}</p>
        <a href="/#services" class="primary-button">
          <div class="button-text">{s.about.button}</div>
          <span
            aria-hidden="true"
            class="button-arrow"
            set:html={ICONS.rightArrow}
          />
        </a>
      </div>
      {
        aboutGallery ? (
          <div data-scroll-reveal class="home-page-image-wrapper">
            <ImageCarousel images={aboutGallery} alt={s.about.imageAlt} />
          </div>
        ) : (
          about?.image && (
            <div data-scroll-reveal class="home-page-image-wrapper">
              <ZoomImage
                src={about.image}
                alt={s.about.imageAlt}
                class="about-image"
                group="about-page"
                widths={[480, 768, 1200]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
          )
        )
      }
    </div>
  </div>
</section>
