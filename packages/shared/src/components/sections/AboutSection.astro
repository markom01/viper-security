---
import { Image } from "astro:assets";
const { pageContent } = Astro.props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
import { ICONS } from "../../config/icons";
const s = resolveLabels(pageContent, STRINGS);
const about = pageContent?.about;
---

<section id="about" class="section home-about-section">
  <div class="content-wrapper">
    <div class="home-about-content">
      <div data-scroll-reveal class="home-about-text-wrapper">
        <div class="about-heading">
          <div class="subheadline-wrapper">
            <div class="subheadline-line"></div>
            <div class="subheadline">{s.about.subheadline}</div>
          </div>
          <h2>{about?.heading}</h2>
        </div>
        <p>{about?.text}</p>
        <a href="/#about" class="primary-button">
          <div class="button-text">{s.about.button}</div>
          <span
            aria-hidden="true"
            class="button-arrow"
            set:html={ICONS.rightArrow}
          />
        </a>
      </div>
      {
        about?.image && (
          <div data-scroll-reveal class="home-page-image-wrapper">
            <Image
              src={about.image}
              loading="eager"
              alt={s.about.imageAlt}
              class="about-image"
              width={about.image.width}
              height={about.image.height}
            />
          </div>
        )
      }
    </div>
  </div>
</section>
