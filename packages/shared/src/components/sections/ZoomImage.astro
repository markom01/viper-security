---
/**
 * Wraps an Astro <Image> in a PhotoSwipe lightbox trigger. Renders as
 * `<a data-lightbox="{group}">` so the page-level lightbox script (injected
 * once in BaseLayout) picks it up; `data-pswp-width/height` carry the
 * intrinsic dims PhotoSwipe needs.
 *
 * `class` passes to the <Image> so existing per-image CSS (`.hero-image`,
 * `.about-image`, …) keeps working; the anchor itself gets `zoomable`.
 *
 * group: lightbox gallery id — images sharing an id navigate together in the
 * full-screen modal (e.g. carousel slides all `about`). Defaults to `page`.
 */
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { imageDims } from "../../lib/imageDims";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  group?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "sync" | "auto";
  class?: string;
  anchorClass?: string;
  width?: number | string;
  height?: number | string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}

const {
  src,
  alt,
  group = "page",
  loading = "lazy",
  decoding = "async",
  class: imgClass,
  anchorClass = "",
  width,
  height,
  widths,
  sizes,
  eager = false,
} = Astro.props as Props;

let dims: { width: number; height: number };
try {
  dims = width && height ? { width: Number(width), height: Number(height) } : await imageDims(src);
} catch (err) {
  console.warn(`[ZoomImage] fallback dims for ${typeof src === "string" ? src : src.src}`, err);
  dims = { width: Number(width) || 800, height: Number(height) || 600 };
}
let optimized: { src: string };
if (typeof src === "string" && /^\s*(javascript|data|vbscript):/i.test(src)) {
  optimized = { src: "/images/placeholder.webp" };
} else {
  try {
    optimized = await getImage({ src, width: dims.width, height: dims.height });
  } catch (err) {
    console.warn(`[ZoomImage] getImage failed for ${typeof src === "string" ? src : src.src}`, err);
    optimized = { src: typeof src === "string" ? src : src.src };
  }
}

---

<a
  href={optimized.src}
  class={`zoomable${anchorClass ? " " + anchorClass : ""}`}
  data-lightbox={group}
  data-pswp-width={dims.width}
  data-pswp-height={dims.height}
  aria-label={`Open ${alt} full screen`}
>
  <Image
    src={optimized.src}
    alt=""
    aria-hidden="true"
    class={imgClass}
    loading={eager ? "eager" : loading}
    decoding={decoding}
    width={dims.width}
    height={dims.height}
    widths={widths}
    sizes={sizes}
  />
</a>

<style>
  .zoomable {
    display: block;
    cursor: zoom-in;
    line-height: 0;
  }
</style>
