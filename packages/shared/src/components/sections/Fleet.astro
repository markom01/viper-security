---
import ZoomImage from "./ZoomImage.astro";
import ImageCarousel from "./ImageCarousel.astro";
import CollectionHeading from "./CollectionHeading.astro";
import type { FleetEntry, FleetVehicleData, PageContent } from "../../types";
import { cleanPhone } from "../../lib/phone";
interface Props {
  pageContent?: PageContent;
  fleetFeatures?: string;
  vehicles?: FleetEntry[];
  /** Inquiry number for the per-card WhatsApp button. Omitted → no button. */
  whatsappPhone?: string;
}
const { pageContent, fleetFeatures, vehicles, whatsappPhone } = Astro.props as Props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
const s = resolveLabels(pageContent, STRINGS);
const f = pageContent?.fleet;

// CMS leaves empty strings for unset fields, so trim before treating a value
// as present (schema does not coerce "" to undefined).
const present = (x: unknown) => {
  const v = String(x ?? "").trim();
  return v || undefined;
};

// Card title: composed from the NHTSA `vehicle` fields (year make model) so
// sale cards need no separate name field. Falls back to the legacy `name`
// for chauffeur/armored entries that carry no make/model breakdown.
const vehicleTitle = (d: FleetVehicleData) => {
  const make = present(d.vehicle?.make);
  const model = present(d.vehicle?.model);
  if (!make && !model) return present(d.name) || "";
  return [present(d.vehicle?.year || d.year), make, model]
    .filter((x): x is string => !!x)
    .join(" ");
};

// Inquiry message: the listing title only, per the client's request.
const waMessage = (d: FleetVehicleData) => vehicleTitle(d);
---

<section
  id="fleet"
  class="section home-about-section fleet"
  data-count={String(vehicles?.length ?? 0)}
>
  <div class="content-wrapper">
    <CollectionHeading>
      <div class="subheadline" slot="label">{s.fleet.subheadline}</div>
      <h2>{f?.heading}</h2>
      {fleetFeatures && <p>{fleetFeatures}</p>}
    </CollectionHeading>
    <div data-scroll-reveal>
        <ul class="_3-column-collection" data-count={String(vehicles?.length ?? 0)}>
          {
            vehicles?.map((v: FleetEntry) => {
              const d = v.data || {};
              const title = vehicleTitle(d);
              // Card image: gallery first (carousel only when there are several),
              // then the legacy single `image` field used by chauffeur fleets.
              const primaryImage = d.images?.[0] ?? d.image;
              // Year: sale entries carry it on `vehicle`, chauffeur entries on
              // the legacy top-level `year`. Empty strings count as absent.
              // Legacy caps block is for chauffeur-fleet entries only. Sale
              // entries carry the year on `vehicle`, so `vehicle.year` alone
              // must not light up an otherwise empty Year/Seats/Baggage table.
              const legacyYear = present(d.year);
              const legacyCaps = [
                legacyYear,
                d.seats,
                d.baggage,
                d.capacity_passengers,
                d.capacity_suitcases,
                d.capacity_carryon,
              ].some((x) => present(x) !== undefined);
              // Right-of-image data: per-vehicle `specs` rows when present, else the
              // legacy passenger-car fields. Chunked 3-per-row to reuse the card grid.
              const specRows: { label: string; value: string }[][] = [];
              if (d.specs?.length) {
                for (let i = 0; i < d.specs.length; i += 3)
                  specRows.push(d.specs.slice(i, i + 3));
              }
              return (
                <li>
                  <div
                    class="car-card"
                    style="border-color: var(--colors--cloud);"
                  >
                    <div class="car-card-details">
                      <div class="car-card-left">
                        <div class="car-listing-info-wrapper">
                          <h3 class="car-listing-name">{title}</h3>
                          {present(d.type) && (
                            <div class="car-listing-type">{d.type}</div>
                          )}
                        </div>
                        {present(d.description) && (
                          <p class="car-card-description">{d.description}</p>
                        )}
                        <div
                          class:list={[
                            "car-listing-image-wrapper",
                            {
                              "car-listing-image-wrapper--single":
                                primaryImage &&
                                !(d.images && d.images.length > 1),
                            },
                          ]}
                        >
                          {d.images && d.images.length > 1 ? (
                            <ImageCarousel
                              images={d.images}
                              alt={title}
                              id={`fleet-${v.id}-carousel`}
                              group={`fleet-${v.id}`}
                            />
                          ) : primaryImage ? (
                            <ZoomImage
                              src={primaryImage}
                              alt={title}
                              class="car-listing-image"
                              group="fleet"
                              widths={[320, 480, 640]}
                              sizes="(max-width: 767px) 100vw, (max-width: 991px) 50vw, 400px"
                            />
                          ) : null}
                        </div>
                      </div>
                      {(specRows.length > 0 || legacyCaps) && (
                        <div class="car-card-data">
                          {specRows.length ? (
                            specRows.map((row) => (
                              <div class="car-listing-details-wrapper">
                                {row.map((cell, i) => (
                                  <>
                                    <div class="car-listing-detail">
                                      <div class="listing-label">
                                        {cell.label}
                                      </div>
                                      <div class="listing-detail">
                                        {cell.value}
                                      </div>
                                    </div>
                                    {i < row.length - 1 && (
                                      <div class="listing-detail-divider" />
                                    )}
                                  </>
                                ))}
                              </div>
                            ))
                          ) : (
                            <>
                              <div class="car-listing-details-wrapper">
                                <div class="car-listing-detail">
                                  <div class="listing-label">
                                    {s.fleet.year}
                                  </div>
                                  <div class="listing-detail">{legacyYear}</div>
                                </div>
                                <div class="listing-detail-divider" />
                                <div class="car-listing-detail">
                                  <div class="listing-label">
                                    {s.fleet.seats}
                                  </div>
                                  <div class="listing-detail">{d.seats}</div>
                                </div>
                                <div class="listing-detail-divider" />
                                <div class="car-listing-detail">
                                  <div class="listing-label">
                                    {s.fleet.baggage}
                                  </div>
                                  <div class="listing-detail">{d.baggage}</div>
                                </div>
                              </div>
                              <div class="car-listing-details-wrapper">
                                <div class="car-listing-detail">
                                  <div class="listing-label">
                                    {s.fleet.capacityPassengers}
                                  </div>
                                  <div class="listing-detail">
                                    {d.capacity_passengers}
                                  </div>
                                </div>
                                <div class="listing-detail-divider" />
                                <div class="car-listing-detail">
                                  <div class="listing-label">
                                    {s.fleet.capacitySuitcases}
                                  </div>
                                  <div class="listing-detail">
                                    {d.capacity_suitcases}
                                  </div>
                                </div>
                                <div class="listing-detail-divider" />
                                <div class="car-listing-detail">
                                  <div class="listing-label">
                                    {s.fleet.capacityCarryon}
                                  </div>
                                  <div class="listing-detail">
                                    {d.capacity_carryon}
                                  </div>
                                </div>
                              </div>
                            </>
                          )}
                        </div>
                      )}
                    </div>
                    {whatsappPhone && (
                      <a
                        class="primary-button car-card-wa"
                        target="_blank"
                        rel="noopener noreferrer"
                        href={`https://wa.me/${cleanPhone(whatsappPhone)}?text=${encodeURIComponent(waMessage(d))}`}
                      >
                        <div class="button-text">{s.fleet.waButton}</div>
                      </a>
                    )}
                    <div style="opacity: 0;" class="car-card-hover-bg" />
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
</section>
<style>
  /* Card count decides the rule:
       1 = full row "before" layout (single wide card)
       3+ = services grid semantics — repeat(auto-fit, minmax(300px, 1fr))
            gives up to 4 cards per row on desktop, 2 at tablet width and
            1 on a phone, exactly like _4-column-collection
       2 = the same base rule (empty auto-fit tracks collapse → 2 wide cards)
     The list carries data-count so the 1-card exception stays selectable
     without :has(). */
  /* Layout mirrors the services section: the .collection-heading-wrapper
     block sits above a full-width grid (global styles supply the spacing). */
  .fleet ._3-column-collection {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  /* 1 card → restore "before" (full row, same as original 1024+ row layout). */
  .fleet ._3-column-collection[data-count="1"] {
    grid-template-columns: 1fr;
  }
  /* 1 card → heading sits beside the wide card (heading right, card left).
     Desktop only: tablet/mobile keep the heading stacked above the card. */
  @media (min-width: 992px) {
    .fleet[data-count="1"] > .content-wrapper {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      column-gap: 40px;
      align-items: start;
    }
    /* `:global` because the heading element lives in CollectionHeading.astro. */
    .fleet[data-count="1"] > .content-wrapper > :global(.collection-heading-wrapper) {
      grid-area: 1 / 2;
      margin-bottom: 0;
    }
    .fleet[data-count="1"] > .content-wrapper > [data-scroll-reveal] {
      grid-area: 1 / 1;
    }
  }
  .fleet ._3-column-collection[data-count="1"] .car-card-details {
    flex-direction: row;
    align-items: flex-start;
  }
  .fleet ._3-column-collection[data-count="1"] .car-card-left {
    width: 50%;
    flex-shrink: 0;
  }
  .fleet ._3-column-collection[data-count="1"] .car-card-data {
    flex: 1;
  }
  /* In a 4-wide grid a card is ~310px: side-by-side data (specs column =
     half card) leaves the label/value rows ~140px wide, so space-between
     collapses to zero gap ("Transmission5-speed manual"). Stack info above
     the specs list at every card size; data-count="1" re-enables the wide
     single-card row below. */
  .fleet .car-card-details {
    flex-direction: column;
    align-items: stretch;
  }
  .car-card-left {
    display: flex;
    flex-direction: column;
  }
  /* Copy needs breathing room before the media block; without it the
     description sits flush against the image. */
  .car-listing-image-wrapper {
    margin-top: 16px;
  }
  /* Single-image cards match the carousel's 4:3 frame so every card in a row
     keeps the same media height. The wide one-card row keeps the image's
     natural ratio; forcing 4:3 there would crop it and stretch the card. */
  .fleet
    ._3-column-collection:not([data-count="1"])
    .car-listing-image-wrapper--single {
    aspect-ratio: 4 / 3;
    border-radius: 20px;
    overflow: hidden;
  }
  /* ZoomImage renders the anchor + img in its own scope, so reach them
     globally. */
  .fleet
    ._3-column-collection:not([data-count="1"])
    .car-listing-image-wrapper--single
    > :global(.zoomable) {
    height: 100%;
  }
  .fleet
    ._3-column-collection:not([data-count="1"])
    .car-listing-image-wrapper--single
    :global(.car-listing-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .car-card-data {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .car-card {
    --card-pad: 20px;
    border: 1px solid var(--colors--cloud);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  /* Card padding drives the details inset and the CTA inset, so the button
     lines up with the copy at every breakpoint. */
  .fleet .car-card-details {
    padding: var(--card-pad);
    flex: 1;
  }
  /* Sale-card copy: inherits the card's type scale, only spacing is set. */
  .car-card-description {
    margin-top: 12px;
    line-height: var(--line-height-sizes--small);
  }
  /* Inquiry CTA sits outside .car-card-details, so it carries its own inset.
     The auto top margin keeps buttons on one line when card copy differs. */
  .fleet .car-card-wa {
    width: fit-content;
    margin: auto var(--card-pad) var(--card-pad);
    padding: 10px 24px;
  }
  /* Mirror the global card-padding breakpoints so the CTA inset tracks them. */
  @media (max-width: 991.98px) {
    .fleet .car-card {
      --card-pad: 16px;
    }
  }
  @media (max-width: 767.98px) {
    .fleet .car-card {
      --card-pad: 22px;
    }
  }
  @media (max-width: 479.98px) {
    .fleet .car-card {
      --card-pad: 14px;
    }
  }
  .car-card:hover .car-card-hover-bg {
    opacity: 1 !important;
  }
  .car-card-hover-bg {
    transition: opacity 0.3s ease;
    pointer-events: none;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.03);
    position: absolute;
    inset: 0%;
  }
  /* Tablet "1fr 1fr" must collapse to 1-col on phone, otherwise cards squeeze. */
  @media (max-width: 767.98px) {
    /* On mobile the "single wide card" row would over-stretch; stack inside. */
    .fleet ._3-column-collection[data-count="1"] .car-card-details {
      flex-direction: column;
      align-items: stretch;
    }
    .fleet ._3-column-collection[data-count="1"] .car-card-left {
      width: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-about-section .home-about-content > *,
    .home-about-section .car-card {
      transform: none !important;
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
