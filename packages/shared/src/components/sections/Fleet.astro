---
import ZoomImage from "./ZoomImage.astro";
import ImageCarousel from "./ImageCarousel.astro";
import type { FleetEntry, FleetVehicleData, PageContent } from "../../types";
import { cleanPhone } from "../../lib/phone";
interface Props {
  pageContent?: PageContent;
  fleetFeatures?: string;
  vehicles?: FleetEntry[];
  /** Inquiry number for the per-card WhatsApp button. Omitted → no button. */
  whatsappPhone?: string;
}
const { pageContent, fleetFeatures, vehicles, whatsappPhone } = Astro.props as Props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
const s = resolveLabels(pageContent, STRINGS);
const f = pageContent?.fleet;

// CMS leaves empty strings for unset fields, so trim before treating a value
// as present (schema does not coerce "" to undefined).
const present = (x: unknown) => {
  const v = String(x ?? "").trim();
  return v || undefined;
};

const waMessage = (d: FleetVehicleData, pagePath: string) =>
  [d.name, d.vehicle?.year || d.year, d.type, d.description, pagePath ? `Details: ${pagePath}` : ""]
    .map(present)
    .filter((x): x is string => !!x)
    .join("\n");
---

<section id="fleet" class="section home-about-section fleet">
  <div class="content-wrapper">
    <div data-scroll-reveal class="collection-heading-wrapper">
      <div class="services-subheadline">
        <div class="subheadline-wrapper">
          <div class="subheadline-line"></div>
          <div class="subheadline">{s.fleet.subheadline}</div>
        </div>
        <h2>{f?.heading}</h2>
        {fleetFeatures && <p>{fleetFeatures}</p>}
      </div>
    </div>
    <div data-scroll-reveal>
        <ul class="_3-column-collection" data-count={(vehicles?.length ?? 0) >= 3 ? "many" : String(vehicles?.length ?? 0)}>
          {
            vehicles?.map((v: FleetEntry) => {
              const d = v.data || {};
              // Year: sale entries carry it on `vehicle`, chauffeur entries on
              // the legacy top-level `year`. Empty strings count as absent.
              const displayYear = present(d.vehicle?.year || d.year);
              const legacyCaps = [
                displayYear,
                d.seats,
                d.baggage,
                d.capacity_passengers,
                d.capacity_suitcases,
                d.capacity_carryon,
              ].some((x) => present(x) !== undefined);
              // Right-of-image data: per-vehicle `specs` rows when present, else the
              // legacy passenger-car fields. Chunked 3-per-row to reuse the card grid.
              const specRows: { label: string; value: string }[][] = [];
              if (d.specs?.length) {
                for (let i = 0; i < d.specs.length; i += 3)
                  specRows.push(d.specs.slice(i, i + 3));
              }
              return (
                <li>
                  <div
                    class="car-card"
                    style="border-color: var(--colors--cloud);"
                  >
                    <div class="car-card-details">
                      <div class="car-card-left">
                        <div class="car-listing-info-wrapper">
                          <h3 class="car-listing-name">{d.name}</h3>
                          <div class="car-listing-type">{d.type}</div>
                        </div>
                        {present(d.description) && (
                          <p class="car-card-description">{d.description}</p>
                        )}
                        <div class="car-listing-image-wrapper">
                          {d.images?.length ? (
                            <ImageCarousel
                              images={d.images}
                              alt={d.name}
                              id={`fleet-${v.id}-carousel`}
                              group={`fleet-${v.id}`}
                            />
                          ) : (
                            d.image && (
                              <ZoomImage
                                src={d.image}
                                alt={d.name}
                                class="car-listing-image"
                                group="fleet"
                                widths={[320, 480, 640]}
                                sizes="(max-width: 767px) 100vw, (max-width: 991px) 50vw, 400px"
                              />
                            )
                          )}
                        </div>
                      </div>
                      <div class="car-card-data">
                        {specRows.length ? (
                          specRows.map((row) => (
                            <div class="car-listing-details-wrapper">
                              {row.map((cell, i) => (
                                <>
                                  <div class="car-listing-detail">
                                    <div class="listing-label">{cell.label}</div>
                                    <div class="listing-detail">{cell.value}</div>
                                  </div>
                                  {i < row.length - 1 && (
                                    <div class="listing-detail-divider" />
                                  )}
                                </>
                              ))}
                            </div>
                          ))
                        ) : legacyCaps ? (
                          <>
                            <div class="car-listing-details-wrapper">
                              <div class="car-listing-detail">
                                <div class="listing-label">{s.fleet.year}</div>
                                <div class="listing-detail">{displayYear}</div>
                              </div>
                              <div class="listing-detail-divider" />
                              <div class="car-listing-detail">
                                <div class="listing-label">{s.fleet.seats}</div>
                                <div class="listing-detail">{d.seats}</div>
                              </div>
                              <div class="listing-detail-divider" />
                              <div class="car-listing-detail">
                                <div class="listing-label">{s.fleet.baggage}</div>
                                <div class="listing-detail">{d.baggage}</div>
                              </div>
                            </div>
                            <div class="car-listing-details-wrapper">
                              <div class="car-listing-detail">
                                <div class="listing-label">
                                  {s.fleet.capacityPassengers}
                                </div>
                                <div class="listing-detail">
                                  {d.capacity_passengers}
                                </div>
                              </div>
                              <div class="listing-detail-divider" />
                              <div class="car-listing-detail">
                                <div class="listing-label">
                                  {s.fleet.capacitySuitcases}
                                </div>
                                <div class="listing-detail">
                                  {d.capacity_suitcases}
                                </div>
                              </div>
                              <div class="listing-detail-divider" />
                              <div class="car-listing-detail">
                                <div class="listing-label">
                                  {s.fleet.capacityCarryon}
                                </div>
                                <div class="listing-detail">
                                  {d.capacity_carryon}
                                </div>
                              </div>
                            </div>
                          </>
                        ) : null}
                      </div>
                    </div>
                    {whatsappPhone && (
                      <a
                        class="primary-button car-card-wa"
                        target="_blank"
                        rel="noopener noreferrer"
                        href={`https://wa.me/${cleanPhone(whatsappPhone)}?text=${encodeURIComponent(waMessage(d, Astro.url.pathname))}`}
                      >
                        <div class="button-text">{s.fleet.waButton}</div>
                      </a>
                    )}
                    <div style="opacity: 0;" class="car-card-hover-bg" />
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
</section>
<style>
  /* Card count decides the rule:
       1 = full row "before" layout (single wide card)
       2 = current auto-fit horizontal (2 side-by-side, wraps naturally)
       3+ = tablet layout on all sizes, wrapping new rows when out of space
     Without a :has(count) selector the grid alone can't distinguish, so
     the list carries data-count and three scoped overrides below. */
  /* Layout mirrors the services section: the .collection-heading-wrapper
     block sits above a full-width grid (global styles supply the spacing).
     Grid defaults apply; the count-driven overrides below are the only
     scoped rules. */
  /* Default (2-card case): auto-fit horizontal wrapping. Works as "now". */
  .fleet ._3-column-collection {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  /* 1 card → restore "before" (full row, same as original 1024+ row layout). */
  .fleet ._3-column-collection[data-count="1"] {
    grid-template-columns: 1fr;
  }
  .fleet ._3-column-collection[data-count="1"] .car-card-details {
    flex-direction: row;
    align-items: flex-start;
  }
  .fleet ._3-column-collection[data-count="1"] .car-card-left {
    width: 50%;
    flex-shrink: 0;
  }
  .fleet ._3-column-collection[data-count="1"] .car-card-data {
    flex: 1;
  }
  /* 3+ cards → "tablet" rule on every viewport: fixed 2-col wrapping. */
  .fleet ._3-column-collection[data-count="many"] {
    grid-template-columns: 1fr 1fr;
  }
  @media (min-width: 768px) {
    .fleet .car-card-details {
      align-items: center;
    }
  }
  .car-card-left {
    display: flex;
    flex-direction: column;
  }
  .car-card-data {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .car-card {
    border: 1px solid var(--colors--cloud);
    border-radius: 12px;
    display: block;
  }
  /* Sale-card copy: inherits the card's type scale, only spacing is set. */
  .car-card-description {
    margin-top: 12px;
    line-height: var(--line-height-sizes--small);
  }
  /* Inquiry CTA sits outside .car-card-details (20px padding), so it carries
     its own inset. */
  .fleet .car-card-wa {
    width: fit-content;
    margin: 0 20px 20px;
    padding: 10px 24px;
  }
  .car-card:hover .car-card-hover-bg {
    opacity: 1 !important;
  }
  .car-card-hover-bg {
    transition: opacity 0.3s ease;
    pointer-events: none;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.03);
    position: absolute;
    inset: 0%;
  }
  /* Tablet "1fr 1fr" must collapse to 1-col on phone, otherwise cards squeeze. */
  @media (max-width: 767.98px) {
    .fleet ._3-column-collection[data-count="many"] {
      grid-template-columns: 1fr;
    }
    /* On mobile the "single wide card" row would over-stretch; stack inside. */
    .fleet ._3-column-collection[data-count="1"] .car-card-details {
      flex-direction: column;
      align-items: stretch;
    }
    .fleet ._3-column-collection[data-count="1"] .car-card-left {
      width: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-about-section .home-about-content > *,
    .home-about-section .car-card {
      transform: none !important;
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
