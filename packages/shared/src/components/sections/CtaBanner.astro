---
import { Image } from "astro:assets";
const { pageContent } = Astro.props;
import { ICONS } from "../../config/icons";
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
const s = resolveLabels(pageContent, STRINGS);
---

<section class="section marketing-section">
  <div class="content-wrapper">
    <div class="marketing-content-wrapper">
      <div data-scroll-reveal class="marketing-text">
        <div class="marketing-text-wrapper">
          <h2 class="marketing-heading">{pageContent?.cta?.heading}</h2>
          <p class="pure-text">{pageContent?.cta?.text}</p>
        </div>
        <a href="/#contact" class="secondary-button">
          <div class="button-text">{s.cta.button}</div>
          <span
            aria-hidden="true"
            class="button-arrow"
            set:html={ICONS.rightArrowPure}
          />
        </a>
      </div>
      <div data-scroll-reveal class="marketing-image-wrapper">
        {
          pageContent?.cta?.image && (
            <Image
              src={pageContent.cta.image}
              loading="eager"
              alt={s.cta.imageAlt}
              class="marketing-image"
              width="600"
              height="500"
            />
          )
        }
      </div>
    </div>
  </div>
</section>
