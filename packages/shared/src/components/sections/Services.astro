---
import ZoomImage from "./ZoomImage.astro";
import type { ServiceOffering, PageContent } from "../../types";
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
interface Props {
  pageContent?: PageContent;
  marbella?: ServiceOffering[];
  milano?: ServiceOffering[];
}
const { pageContent, marbella, milano } = Astro.props as Props;
const s = resolveLabels(pageContent, STRINGS);
// Services are universal — both props carry the same data, pick whichever exists
const services = marbella || milano || [];
---

<section id="services" class="section services-section">
  <div class="content-wrapper">
    <div data-scroll-reveal class="collection-heading-wrapper">
      <div class="services-subheadline">
        <div class="subheadline-wrapper">
          <div class="subheadline-line"></div>
          <h2 class="subheadline">{s.services.subheadline}</h2>
        </div>
      </div>
    </div>
    <div data-scroll-reveal>
      <div role="list" class="_4-column-collection">
        {
          services.map((svc: ServiceOffering) => (
            <div role="listitem" class="service-collection-item">
              <div class="service-card">
                {(() => { const _img = svc.image ?? svc.hero?.image; return _img ? (
                  <ZoomImage
                    src={_img}
                    alt={svc.title}
                    class="service-listing-image"
                    group="services"
                    width="400"
                    height="300"
                    widths={[320, 480, 768]}
                    sizes="(min-width: 991px) 25vw, (min-width: 640px) 50vw, 100vw"
                  />
                ) : null; })()}
                <div class="service-info-wrapper">
                  <h3 class="service-listing-name">{svc.title}</h3>
                  <div class="service-short-description">
                    {svc.description}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
<style>
  .service-card:hover .service-short-description,
  .service-card:focus-within .service-short-description {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
  @media (hover: none) {
    .service-short-description {
      opacity: 1 !important;
      transform: none !important;
    }
  }
  .service-short-description {
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    transform: translateY(8px);
  }
</style>
