---
/**
 * Scroll-snap image carousel. Swipe is native (pure CSS scroll-snap); dots are
 * `<a href="#slide-n">` fragment anchors (work with JS off). Prev/next arrows
 * step ±1 slide via a tiny inline script — the one thing fragment anchors
 * can't do (relative nav needs JS).
 *
 * Props: images = ImageMetadata[] (Astro `image()` refs), alt.
 *
 * Only real gaps vs a JS lib: autoplay, infinite loop, one-slide-per-gesture
 * on Safari (scroll-snap-stop not implemented — WebKit #221970), screen-reader
 * slide-index announcement. None needed for a gallery strip.
 */
import ZoomImage from "./ZoomImage.astro";
import type { ImageMetadata } from "astro";
interface Props {
  /** Astro ImageMetadata refs or public-path strings (CMS-picked). */
  images: (ImageMetadata | string)[];
  alt: string;
}
const { images, alt } = Astro.props as Props;
const total = images.length;
const baseId = "about-carousel";
---

<div
  class="carousel"
  data-carousel-root
  aria-roledescription="carousel"
  aria-label={alt}
>
  <div class="carousel-viewport" tabindex="0" role="region" aria-label={`${alt} — scrollable images, use arrow buttons or swipe`}>
    <div class="carousel-track">
      {
        images.map((img, i) => (
          <div
            id={`${baseId}-slide-${i + 1}`}
            class="carousel-slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
          >
            <ZoomImage
              src={img}
              alt={alt}
              class="carousel-image"
              anchorClass="carousel-zoom"
              group="about"
              widths={[480, 768, 1200]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
          </div>
        ))
      }
    </div>
  </div>

  <button
    class="carousel-arrow carousel-arrow-prev"
    type="button"
    data-carousel-prev
    aria-label="Previous slide"
  >
    <span aria-hidden="true">&#8249;</span>
  </button>
  <button
    class="carousel-arrow carousel-arrow-next"
    type="button"
    data-carousel-next
    aria-label="Next slide"
  >
    <span aria-hidden="true">&#8250;</span>
  </button>

  <div class="carousel-dots" role="group" aria-label="Choose slide">
    {
      images.map((_, i) => (
        <a
          class="carousel-dot"
          href={`#${baseId}-slide-${i + 1}`}
          aria-label={`Go to slide ${i + 1}`}
        ></a>
      ))
    }
  </div>
</div>

<script>
  // Step prev/next on the scroll-snap viewport. ~15 lines, no lib.
  // NB: don't use document.currentScript in Astro (scripts are bundled modules
  // where it's null at run time) — query the component root by attribute.
  for (const root of document.querySelectorAll("[data-carousel-root]")) {
    const viewport = root.querySelector(".carousel-viewport");
    if (!viewport) continue;
    const reduced = window.matchMedia?.(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    const step = (dir) => {
      const w = viewport.clientWidth;
      const next =
        Math.round(viewport.scrollLeft / w + dir) * w;
      viewport.scrollTo({
        left: Math.max(0, Math.min(next, viewport.scrollWidth - w)),
        behavior: reduced ? "auto" : "smooth",
      });
    };
    const prev = root.querySelector("[data-carousel-prev]");
    const next = root.querySelector("[data-carousel-next]");
    prev?.addEventListener("click", () => step(-1));
    next?.addEventListener("click", () => step(1));
  }
</script>

<style>
  .carousel {
    position: relative;
    width: 100%;
  }
  .carousel-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    outline-offset: 4px;
    aspect-ratio: 4 / 3;
    max-height: 100%;
  }
  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }
  .carousel-track {
    display: flex;
    height: 100%;
  }
  .carousel-slide {
    flex: 0 0 calc(100% - 16px);
    margin-right: 16px; /* spacing between slides; keeps snap offsets = width */
    scroll-snap-align: start;
    scroll-snap-stop: always;
    scroll-margin-inline-start: 0;
    min-width: 0;
    height: 100%;
    overflow: hidden;
  }
  .carousel-arrow {
    position: absolute;
    top: 42%;
    z-index: 1;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .carousel-arrow:hover {
    background: rgba(0, 0, 0, 0.7);
  }
  .carousel-arrow:focus-visible {
    outline: 2px solid var(--colors--gold, #fff);
    outline-offset: 2px;
  }
  .carousel-arrow-prev {
    left: 10px;
  }
  .carousel-arrow-next {
    right: 10px;
  }
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 10px 0 4px;
  }
  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.4);
    transition: background 0.2s ease;
  }
  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.8);
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-viewport {
      scroll-behavior: auto;
    }
  }
</style>

<style is:global>
  /* ZoomImage (different Astro scope) renders the carousel <a> + <img>, so the
     fill-the-box rules must be GLOBAL — scoped rules can't reach them. */
  .carousel-zoom {
    display: block;
    height: 100%;
  }
  .carousel-zoom .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }
</style>
