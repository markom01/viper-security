---
/**
 * Shared sectioned gallery — masonry grids with PhotoSwipe lightbox.
 * Ported from the DBC gallery page so both sites share one implementation.
 *
 * Props:
 * - heading / subheadline: page header copy (site provides, CMS-editable upstream)
 * - sections: [{ key, title, items: [{ id, href, image, alt, width, height }] }]
 *   Each section renders its own masonry grid so lightbox nav stays in-group.
 *
 * Data pipeline (getCollection + imageDims + getImage) lives in the page,
 * not here — this component only renders what it is given.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  id: string;
  href: string;
  image: string | ImageMetadata;
  alt: string;
  width: number;
  height: number;
}

interface GallerySection {
  key: string;
  title: string;
  items: GalleryItem[];
}

interface Props {
  sections: GallerySection[];
  heading: string;
  subheadline?: string;
}

const { sections, heading, subheadline } = Astro.props as Props;
---

<section class="gallery-section">
  <div class="content-wrapper">
    <header class="gallery-header">
      <h1>{heading}</h1>
      {subheadline && <p>{subheadline}</p>}
    </header>
    {
      sections.map((section) => (
        <section class="gallery-group">
          <h2 class="gallery-group-title">{section.title}</h2>
          <div class="masonry" data-masonry data-gallery>
            {
              section.items.map((item) => (
                <div class="masonry-item">
                  <a
                    href={item.href}
                    class="gallery-item"
                    data-pswp-width={item.width}
                    data-pswp-height={item.height}
                    aria-label={item.alt}
                  >
                    <Image
                      src={item.image}
                      alt={item.alt}
                      width={item.width}
                      height={item.height}
                      loading="lazy"
                      decoding="async"
                      widths={[480, 768]}
                      sizes="(min-width: 991px) 33vw, (min-width: 640px) 50vw, 100vw"
                    />
                  </a>
                </div>
              ))
            }
          </div>
        </section>
      ))
    }
  </div>
</section>

<style>
  .gallery-section {
    /* Navbar is absolute, so the first section must clear it (same offset as
       the home hero: 180px desktop / 140px mobile). */
    padding: 180px 0 100px;
  }
  .gallery-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .gallery-header h1 {
    font-family: var(--font-families--accent-font);
    font-size: var(--desktop-heading-sizes--h1);
    color: var(--colors--ivory);
    margin-bottom: 12px;
  }
  .gallery-header p {
    color: var(--colors--cloud);
    max-width: 560px;
    margin: 0 auto;
  }
  .gallery-group + .gallery-group {
    margin-top: 56px;
  }
  .gallery-group-title {
    font-family: var(--font-families--accent-font);
    font-size: var(--desktop-heading-sizes--h3);
    color: var(--colors--gold);
    text-align: center;
    margin-bottom: 24px;
  }
  /* Frame the grid: cap width + center, instead of edge-to-edge */
  .masonry {
    max-width: 1160px;
    margin: 0 auto;
  }
  .masonry-item {
    width: 33.333%;
    /* Horizontal gap: padded inside the item so masonry's column math stays
       exact (no `gutter` option — a px gutter fights percentage widths). */
    padding: 0 10px;
    margin-bottom: 20px;
  }
  .masonry-item a {
    display: block;
  }
  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .masonry-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
  }
  @media (max-width: 991.98px) {
    .gallery-section {
      padding: 140px 0 80px;
    }
    .masonry-item {
      width: 50%;
    }
  }
  @media (max-width: 767.98px) {
    .masonry-item {
      width: 100%;
    }
  }
</style>

<script>
  import Masonry from "masonry-layout";
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/dist/photoswipe.css";

  document.querySelectorAll("[data-masonry]").forEach((grid) => {
    const msnry = new Masonry(grid, {
      itemSelector: ".masonry-item",
      columnWidth: ".masonry-item",
      percentPosition: true,
    });
    let t: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(t);
      t = setTimeout(() => msnry.layout(), 100);
    });
  });

  // `gallery: "[data-gallery]"` matches every category grid; each becomes its
  // own PhotoSwipe gallery, so arrow nav stays within the current group.
  const lightbox = new PhotoSwipeLightbox({
    gallery: "[data-gallery]",
    children: "a",
    pswpModule: () => import("photoswipe"),
  });
  lightbox.init();
</script>
