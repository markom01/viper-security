---
import type { PageContent } from "../../types";
interface Props {
  pageContent?: PageContent;
  fleetHref?: string;
  /** Section anchor id (per-site purpose name). Defaults to the legacy id. */
  id?: string;
}
const { pageContent, fleetHref = "/#fleet", id = "bottom-cta" } = Astro.props as Props;
import { ICONS } from "../../config/icons";
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
const s = resolveLabels(pageContent, STRINGS);
const v = pageContent?.bottomcta?.values;
---

<section id={id} class="section banner-section">
  <div class="content-wrapper">
    <div class="home-banner-wrapper">
      <div data-scroll-reveal class="banner">
        <div class="banner-heading-wrapper">
          <h2 class="banner-heading">{pageContent?.bottomcta?.heading}</h2>
          <div class="banner-buttons">
            <a href="/#services" class="primary-button">
              <div class="button-text">{s.bottomCta.buttonServices}</div>
              <span
                aria-hidden="true"
                class="button-arrow"
                set:html={ICONS.rightArrow}
              />
            </a>
            <a href={fleetHref} class="primary-button">
              <div class="button-text">{s.bottomCta.buttonFleet}</div>
              <span
                aria-hidden="true"
                class="button-arrow"
                set:html={ICONS.rightArrow}
              />
            </a>
          </div>
        </div>
        <div class="banner-divider"></div>
        <div class="banner-values-wrapper">
          {v?.map((item) => (
            <div class="banner-value-item">
              <span aria-hidden="true" set:html={ICONS.checkMark} />
              <div class="value-text-wrapper">
                <h3 class="value-heading">{item.title}</h3>
                <p class="banner-value-text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
