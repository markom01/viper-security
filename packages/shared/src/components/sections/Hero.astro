---
import ZoomImage from "./ZoomImage.astro";
import BookingForm from "./BookingForm.astro";
import type { PageContent } from "../../types";
interface Props {
  pageContent?: PageContent;
  subtitle?: string;
  cta_text?: string;
  tagline?: string;
  hero_image?: string;
  phoneItaly?: string;
  phoneSpain?: string;
  fleetHref?: string;
  services?: { title: string; slug?: string; form_fields?: { label: string; placeholder?: string; name: string; side?: string; type?: string }[] }[];
  presetService?: string;
  form_fields?: { label: string; placeholder?: string; name: string; side?: string; type?: string }[];
}
const { pageContent, subtitle, cta_text, tagline, hero_image, phoneItaly, phoneSpain, fleetHref = "/#fleet", services, presetService = "", form_fields = [] } = Astro.props as Props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
import { ICONS } from "../../config/icons";
const s = resolveLabels(pageContent, STRINGS);
---

<section class="section home-hero-section">
  <div class="content-wrapper">
    <div class="hero-container">
      <div data-scroll-reveal class="hero-text-wrapper">
        <div class="hero-heading-wrapper"><h1>{tagline}</h1></div>
        <div class="hero-text-details">
          <p>{subtitle}</p>
          <div class="subheadline-wrapper"><div class="subheadline-line"></div><div class="subheadline">{cta_text}</div></div>
        </div>
      </div>
      <div class="hero-content-wrapper">
        <div class="hero-buttons-wrapper">
          <div class="hero-button-left">
            <a href="/#about" class="secondary-button small"><div class="button-text">{s.hero.learnMore}</div><span aria-hidden="true" class="button-arrow" set:html={ICONS.rightArrowPure} /></a>
          </div>
          <div class="hero-button-right">
            <a href={fleetHref} class="secondary-button small"><div class="button-text">{s.hero.exploreFleet}</div><span aria-hidden="true" class="button-arrow" set:html={ICONS.rightArrowPure} /></a>
          </div>
        </div>
        <div class="hero-image-wrapper">
          {hero_image && <ZoomImage src={hero_image} alt={s.hero.imageAlt} class="hero-image" group="hero" eager widths={[480, 768, 1080, 1440]} sizes="(min-width: 1350px) 1310px, 100vw" />}
        </div>
        <BookingForm pageContent={pageContent} phoneItaly={phoneItaly} phoneSpain={phoneSpain} services={services} presetService={presetService} form_fields={form_fields} />
      </div>
    </div>
  </div>
</section>
