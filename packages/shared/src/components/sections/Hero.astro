---
import ZoomImage from "./ZoomImage.astro";
import FormField from "./FormField.astro";
import { jsonEscape } from "../../config/json-escape";
const { pageContent } = Astro.props;
const {
  subtitle,
  cta_text,
  tagline,
  hero_image,
  phoneItaly,
  phoneSpain,
  fleetHref = "/#fleet",
  services,
  // Service already implied by the page (service detail pages): suppress the
  // service <select> and inject this title into the WhatsApp message instead.
  presetService = "",
  // Service-specific extra form fields: { label, placeholder?, name }[].
  // Rendered on the left side after Phone; values appended to the WhatsApp message.
  form_fields = [],
} = Astro.props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
import { ICONS } from "../../config/icons";
const s = resolveLabels(pageContent, STRINGS);

const bd = pageContent?.booking_data;
const hasBooking = !!(
  bd &&
  (bd.spain?.services?.length || bd.italy?.services?.length)
);
const SCRIPT_DATA = {
  spain: bd?.spain || { label: "", services: [] },
  italy: bd?.italy || { label: "", services: [] },
  SS: s.form.selectService,
  SR: s.form.selectRoute,
  CL: s.form.chooseLocationFirst,
  CS: s.form.chooseServiceFirst,
  SP: s.form.pricePlaceholder,
  PI: phoneItaly || "",
  PS: phoneSpain || "",
  // Preset service on detail pages — no select rendered, injected into msg.
  PSV: presetService || "",
  SN: pageContent?.jsonld?.org_name,
  HB: hasBooking,
  // Garage (DBC) variant: service titles from the `services` prop.
  SERVICES: Array.isArray(services)
    ? services.map((x) => x?.title).filter(Boolean)
    : [],
};
// Inert JSON tag (never executed, so CSP script-src does not apply).
// jsonEscape strips any `</script>` breakout from CMS content.
const __heroData = jsonEscape(JSON.stringify(SCRIPT_DATA));
---

<section class="section home-hero-section">
  <div class="content-wrapper">
    <div class="hero-container">
      <div data-scroll-reveal class="hero-text-wrapper">
        <div class="hero-heading-wrapper">
          <h1>{tagline}</h1>
        </div>
        <div class="hero-text-details">
          <p>{subtitle}</p>
          <div class="subheadline-wrapper">
            <div class="subheadline-line"></div>
            <div class="subheadline">{cta_text}</div>
          </div>
        </div>
      </div>
      <div class="hero-content-wrapper">
        <div class="hero-buttons-wrapper">
          <div class="hero-button-left">
            <a href="/#about" class="secondary-button small">
              <div class="button-text">{s.hero.learnMore}</div>
              <span
                aria-hidden="true"
                class="button-arrow"
                set:html={ICONS.rightArrowPure}
              />
            </a>
          </div>
          <div class="hero-button-right">
            <a href={fleetHref} class="secondary-button small">
              <div class="button-text">{s.hero.exploreFleet}</div>
              <span
                aria-hidden="true"
                class="button-arrow"
                set:html={ICONS.rightArrowPure}
              />
            </a>
          </div>
        </div>
        <div class="hero-image-wrapper">
          {
            hero_image && (
              <ZoomImage
                src={hero_image}
                alt={s.hero.imageAlt}
                class="hero-image"
                group="hero"
                eager
                widths={[480, 768, 1080, 1440]}
                sizes="(min-width: 1200px) 100vw, 100vw"
              />
            )
          }
        </div>
        <div
          id="contact"
          style="opacity:1;overflow:visible;position:relative;border-top:none;"
          class="booking-form-wrapper"
        >
          <div
            style="position:absolute;top:0;left:0;right:0;height:8px;background:var(--colors--amber);z-index:1;border-radius:24px 24px 0 0;"
          >
          </div>
          <div class="booking-form-block">
            <form
              class={`booking-form${hasBooking ? "" : " garage-form"}`}
              aria-label={s.hero.bookingFormAria}
              data-netlify="true"
              name="booking-form"
            >
              <div class="left-side-fields">
                <div class="booking-form-label-field">
                  <label class="booking-form-label" for="full-name"
                    >{s.form.name}</label
                  >
                  <input
                    class="booking-form-field"
                    id="full-name"
                    name="Full-Name"
                    placeholder={s.form.namePlaceholder}
                    type="text"
                    required
                    aria-label="Full Name"
                    aria-describedby="full-name-error"
                  />
                </div>
                <div class="booking-form-label-field">
                  <label class="booking-form-label" for="phone"
                    >{s.form.phone}</label
                  >
                  <input
                    class="booking-form-field"
                    id="phone"
                    name="Phone"
                    placeholder={s.form.phonePlaceholder}
                    type="tel"
                    required
                    aria-label="Phone"
                    aria-describedby="phone-error"
                  />
                </div>
                {
                  form_fields.length > 0 &&
                    form_fields
                      .filter((f) => f.side !== "right")
                      .map((f) => <FormField f={f} />)
                }
                {
                  hasBooking && (
                    <div class="booking-form-label-field">
                      <label class="booking-form-label" for="form-location">
                        {s.form.location}
                      </label>
                      <select
                        class="booking-form-field"
                        name="Location"
                        id="form-location"
                        required
                        aria-label="Location"
                      >
                        <option value="">{s.form.selectLocation}</option>
                        <option value="spain">{bd?.spain?.label}</option>
                        <option value="italy">{bd?.italy?.label}</option>
                      </select>
                    </div>
                  )
                }
              </div>
              <div class="right-side-fields">
                {
                  hasBooking && (
                    <div class="booking-form-label-field">
                      <label class="booking-form-label" for="form-service">
                        {s.form.service}
                      </label>
                      <select
                        class="booking-form-field"
                        name="Service"
                        id="form-service"
                        required
                        disabled
                        aria-label="Service"
                      >
                        <option value="">{s.form.chooseLocationFirst}</option>
                      </select>
                    </div>
                  )
                }
                {
                  hasBooking && (
                    <div class="booking-form-label-field">
                      <label class="booking-form-label" for="form-destination">
                        {s.form.destination}
                      </label>
                      <select
                        class="booking-form-field"
                        name="Destination"
                        id="form-destination"
                        required
                        disabled
                        aria-label="Destination"
                      >
                        <option value="">{s.form.chooseServiceFirst}</option>
                      </select>
                    </div>
                  )
                }
                {
                  form_fields.length > 0 &&
                    form_fields
                      .filter((f) => f.side === "right")
                      .map((f) => <FormField f={f} />)
                }
                <div class="booking-form-label-field">
                  <label class="booking-form-label" for="pickup-date"
                    >{s.form.date}</label
                  >
                  <input
                    class="booking-form-field"
                    id="pickup-date"
                    name="Pick-Up-Date"
                    type="date"
                    required
                    aria-label={s.form.date}
                  />
                </div>
                {
                  !hasBooking && (
                    <div class="booking-form-label-field">
                      <label class="booking-form-label" for="form-message">
                        {s.form.message}
                      </label>
                      <input
                        class="booking-form-field"
                        id="form-message"
                        name="Message"
                        type="text"
                        placeholder={s.form.messagePlaceholder}
                        aria-label="Message"
                      />
                    </div>
                  )
                }
                {
                  !hasBooking && !presetService && (
                    <div class="booking-form-label-field">
                      <label class="booking-form-label" for="form-service">
                        {s.form.service}
                      </label>
                      <select
                        class="booking-form-field"
                        name="Service"
                        id="form-service"
                        required
                        aria-label="Service"
                      >
                        <option value="">{s.form.selectService}</option>
                        {SCRIPT_DATA.SERVICES.map((t) => (
                          <option value={t}>{t}</option>
                        ))}
                      </select>
                    </div>
                  )
                }
                {
                  !hasBooking && presetService && (
                    <input type="hidden" name="Service" value={presetService} />
                  )
                }
              </div>
              <div class="form-bottom-row">
                {
                  hasBooking && (
                    <div class="booking-form-label-field" id="form-price-field">
                      <label class="booking-form-label">
                        {s.form.priceLabel}
                      </label>
                      <div
                        class="booking-form-price"
                        id="form-price-value"
                        data-state="placeholder"
                      >
                        {s.form.pricePlaceholder}
                      </div>
                    </div>
                  )
                }
                <div class="booking-button-wrapper">
                  <input
                    type="submit"
                    class="booking-form-button home-booking-form"
                    value={s.form.bookNow}
                  />
                </div>
              </div>
            </form>
            <div
              class="booking-form-success"
              role="status"
              style="display:none"
            >
              <div>{s.form.success}</div>
            </div>
            <div class="form-error-message" role="alert" style="display:none">
              <div>{s.form.error}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .booking-form-price[data-state="placeholder"] {
    font-family: var(--font-families--body-font);
    font-size: var(--body-text-sizes--small);
    font-weight: 400;
    color: var(--colors--slate);
    text-transform: uppercase;
    padding: 8px 0;
    line-height: 22.8571px;
    background: transparent;
    border-radius: 0;
    display: block;
    width: 100%;
    box-sizing: border-box;
  }
  .booking-form-price:not([data-state="placeholder"]) {
    font-family: var(--font-families--accent-font);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--colors--gold);
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    display: inline-block;
  }
  .booking-form {
    flex-wrap: wrap;
    gap: 18px 44px;
  }
  .left-side-fields {
    margin-right: 0 !important;
  }
  .right-side-fields {
    margin-left: 0 !important;
  }
  .booking-form-label-field {
    min-width: 0;
  }
  .booking-form-field {
    width: 100%;
  }
  @media (min-width: 992px) {
    .left-side-fields,
    .right-side-fields {
      width: calc(50% - 22px) !important;
    }
    /* Garage form = one continuous grid (no left/right columns). The two
       side wrappers are transparent (display: contents), so every field
       auto-places into a single 4-col row and wraps to the next row. The
       last field stretches to the final column (auto / -1), so a partially
       filled last row never leaves trailing empty cells. */
    .garage-form {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-column-gap: 44px;
      grid-row-gap: 18px;
      align-items: end;
      /* Source order (no dense backfill): 2-col-spanning items like the
         vehicle block flow beside same-row fields instead of scrambling. */
      grid-auto-flow: row;
    }
    .garage-form .left-side-fields,
    .garage-form .right-side-fields {
      display: contents;
    }
    /* Garage form has no price field, so the 2-col bottom row would leave the
       right half empty — single column, button right-aligned (matches the
       chauffeur layout's right-side CTA placement). */
    /* form-bottom-row hosts the submit button (and price field for chauffeur).
       For garage-form it's transparent (display:contents), so the submit button
       (and any price field) becomes a direct grid item of the booking form —
       same 1-column width as fields, counted in the balanced distribution. */
    .garage-form .form-bottom-row {
      display: contents;
    }
    /* Vehicle selector: `display: contents` makes the 4 sub-fields (type |
       make | model | year) become direct grid items of the booking form so they
       count as 4 columns in the balanced grid — e.g. auction's 10 leaf fields
       lay out 5+5. The block itself is transparent; its children size themselves
       via the column tracks. Global selector: `.vehicle-fields` is rendered by
       DropdownInput.astro (different component scope), so Hero's scoped id
       never matches it. */
    :global(.garage-form .vehicle-fields) {
      display: contents;
    }
    /* Uniform field width across every form: .booking-form-field is
       inline-block by default, so inputs/selects size to content (178/135px)
       instead of their grid cell. width:100% makes every field the same width
       as its column. The global .booking-form-label-field{width:100%} would
       stretch a lone field to the whole row, so garage-form label-fields use
       width:auto — the grid track (not width) governs the size. */
    :global(.garage-form .booking-form-label-field) {
      width: auto !important;
    }
    :global(.garage-form .booking-form-field) {
      width: 100%;
    }
    /* Submit button, direct grid item via form-bottom-row display:contents:
       fills its single column track exactly like an input field. */
    :global(.garage-form .booking-button-wrapper) {
      width: 100%;
    }
  }
  .form-bottom-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-column-gap: 44px;
    align-items: end;
    width: 100%;
  }
  .form-bottom-row > .booking-button-wrapper {
    grid-column: auto;
  }
  /* Garage form tablet: 2-column grid, submit spans the whole last row. The
     two side wrappers stay transparent (contents), vehicle sub-fields collapse
     via their own contents — only the vehicle type + make + model + year
     label-fields become grid items, exactly like desktop. Submit gets
     grid-column: 1 / -1 so it reads as a full-width bar under the 2-up fields
     (better tap target than a half-width button). */
  @media (min-width: 768px) and (max-width: 991px) {
    .garage-form {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-column-gap: 24px;
      grid-row-gap: 18px;
      align-items: end;
      grid-auto-flow: row;
    }
    .garage-form .left-side-fields,
    .garage-form .right-side-fields {
      display: contents;
    }
    .garage-form .form-bottom-row {
      display: contents;
    }
    :global(.garage-form .vehicle-fields) {
      display: contents;
    }
    :global(.garage-form .booking-form-label-field) {
      width: auto !important;
    }
    :global(.garage-form .booking-form-field) {
      width: 100%;
    }
    :global(.garage-form .form-bottom-row > .booking-button-wrapper) {
      width: 100%;
      grid-column: 1 / -1 !important;
    }
  }
  @media (max-width: 991px) {
    .booking-form {
      flex-direction: column;
    }
    .left-side-fields,
    .right-side-fields {
      width: 100%;
      grid-template-columns: 1fr;
      grid-column-gap: 0;
    }
  }
  @media (max-width: 767px) {
    .booking-form {
      flex-direction: column;
    }
    .form-bottom-row {
      grid-template-columns: 1fr;
    }
    .left-side-fields,
    .right-side-fields {
      width: 100%;
      grid-template-columns: 1fr;
      grid-column-gap: 0;
    }
  }
  .booking-form-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
<script
  is:inline
  type="application/json"
  id="hero-data"
  set:html={__heroData}
/>
<script>
  // Read CMS data from the inert JSON tag (CSP-safe; no define:vars inline).
  const raw = document.getElementById("hero-data");
  if (raw) {
    // IIFE: top-level `return` is illegal in a module script.
    (() => {
      interface Region {
        label?: string;
        services: {
          name: string;
          routes: (string | { route: string; price?: string })[];
        }[];
      }
      interface HeroData {
        spain: Region;
        italy: Region;
        SS: string;
        SR: string;
        CL: string;
        CS: string;
        SP: string;
        PI: string;
        PS: string;
        PSV: string;
        SN: string;
        HB: boolean;
        SERVICES: string[];
      }
      const d = JSON.parse(raw.textContent || "{}") as HeroData;
      const R: Record<string, Region> = { spain: d.spain, italy: d.italy };
      const { SS, SR, CL, CS, SP, PI, PS, PSV } = d;
      const HB = !!d.HB;
      const L = document.getElementById(
        "form-location",
      ) as HTMLSelectElement | null;
      const S = document.getElementById(
        "form-service",
      ) as HTMLSelectElement | null;
      const D = document.getElementById(
        "form-destination",
      ) as HTMLSelectElement | null;
      const PV = document.getElementById(
        "form-price-value",
      ) as HTMLElement | null;
      const form = document.querySelector<HTMLFormElement>(".booking-form");
      const btn =
        form?.querySelector<HTMLInputElement>(".booking-form-button") ?? null;
      const formError = document.querySelector<HTMLElement>(
        ".form-error-message",
      );
      const msgIn =
        form?.querySelector<HTMLTextAreaElement>('[name="Message"]') ?? null;
      const pickUpDate = form?.querySelector<HTMLInputElement>(
        '[name="Pick-Up-Date"]',
      );
      const nameIn =
        form?.querySelector<HTMLInputElement>('[name="Full-Name"]') ?? null;
      const phoneIn =
        form?.querySelector<HTMLInputElement>('[name="Phone"]') ?? null;
      // Chauffeur variant needs the location select; garage variant (no
      // booking_data) is a simple name+phone+message form.
      if (!form || !btn || (HB && !L)) return;
      // Rebind to non-null so closures keep the narrowed type (TS loses
      // narrowing of outer `btn` inside nested functions).
      const submitBtn = btn;

      // Set min date to today on the date input
      if (pickUpDate) {
        const t = new Date();
        pickUpDate.min =
          t.getFullYear() +
          "-" +
          (t.getMonth() + 1).toString().padStart(2, "0") +
          "-" +
          t.getDate().toString().padStart(2, "0");
      }

      // Validation helpers
      function validName(v: string): boolean {
        return v.trim().length >= 2 && /^[\p{L}\s\-'.]+$/u.test(v);
      }
      function validPhone(v: string): boolean {
        const d = v.replace(/[\s\-\+\(\)]/g, "");
        return d.length >= 7 && d.length <= 15 && /^[\+\d\s\-\(\)]+$/.test(v);
      }
      // a11y: the injected error is role=alert (announced), and the input gets
      // aria-invalid + aria-describedby pointing at it.
      function showErr(el: HTMLInputElement, m: string): void {
        let mb = el.parentElement?.querySelector<HTMLElement>(".field-error");
        if (!mb) {
          mb = document.createElement("div");
          mb.className = "field-error";
          mb.setAttribute("role", "alert");
          mb.style.cssText =
            "color:var(--colors--coral);font-size:1rem;margin-top:4px;font-family:var(--font-families--body-font);";
          el.parentElement?.appendChild(mb);
        }
        mb.textContent = m;
        el.setAttribute("aria-invalid", "true");
        const described = el.getAttribute("aria-describedby");
        if (described)
          el.setAttribute("aria-describedby", described + " " + mb.className);
        el.setAttribute("data-invalid", "");
      }
      function clearErr(el: HTMLInputElement): void {
        const mb = el.parentElement?.querySelector<HTMLElement>(".field-error");
        if (mb) mb.textContent = "";
        el.removeAttribute("aria-invalid");
        delete el.dataset.invalid;
      }

      // Validation listeners
      if (nameIn && phoneIn) {
        [nameIn, phoneIn].forEach(function (inp) {
          inp.addEventListener("input", function () {
            if (!inp.value) {
              clearErr(inp);
              return;
            }
            const fn = inp === nameIn ? validName : validPhone;
            if (fn(inp.value)) clearErr(inp);
            else
              showErr(
                inp,
                inp === nameIn
                  ? "Please enter your full name (at least 2 characters)"
                  : "Please enter a valid phone number (+ and 7-15 digits)",
              );
            updateBtn();
          });
          inp.addEventListener("blur", function () {
            if (!inp.value)
              showErr(
                inp,
                inp === nameIn ? "Name is required" : "Phone is required",
              );
            else if (!(inp === nameIn ? validName : validPhone)(inp.value))
              showErr(
                inp,
                inp === nameIn
                  ? "Please enter your full name (at least 2 characters)"
                  : "Please enter a valid phone number (+ and 7-15 digits)",
              );
            updateBtn();
          });
        });
      }

      function placeOption(sel: HTMLSelectElement, text: string): void {
        // textContent (not innerHTML): SS/SR/CL/CS are CMS-overridable labels.
        while (sel.firstChild) sel.removeChild(sel.firstChild);
        const o = document.createElement("option");
        o.value = "";
        o.textContent = text;
        sel.appendChild(o);
      }
      function uS(): void {
        if (!S) return;
        const l = L?.value ?? "";
        const s = l && R[l] ? R[l].services : [];
        // Location set but no service yet -> "Select service..." (not the
        // misleading "Choose location first" wording).
        placeOption(S, l ? SS : CL);
        S.disabled = !l;
        for (let i = 0; i < s.length; i++) {
          const o = document.createElement("option");
          o.value = s[i].name;
          o.textContent = s[i].name;
          S.appendChild(o);
        }
        uD();
      }
      function uD(): void {
        if (!D || !S) return;
        const l = L?.value ?? "";
        const sn = S.value;
        let rt: (string | { route: string; price?: string })[] = [];
        if (l && sn && R[l]) {
          const sv = R[l].services;
          for (let i = 0; i < sv.length; i++) {
            if (sv[i].name === sn) {
              rt = sv[i].routes;
              break;
            }
          }
        }
        placeOption(D, sn ? SR : CS);
        D.disabled = !sn;
        for (let j = 0; j < rt.length; j++) {
          const r2 = rt[j];
          const o2 = document.createElement("option");
          o2.value = typeof r2 === "string" ? r2 : r2.route;
          o2.textContent = typeof r2 === "string" ? r2 : r2.route;
          D.appendChild(o2);
        }
        upP();
      }
      function upP(): void {
        if (!PV || !S) return;
        const l = L?.value ?? "";
        const sn = S.value;
        const dn = D?.value ?? "";
        if (!l || !sn || !dn || !R[l]) {
          PV.textContent = SP;
          PV.dataset.state = "placeholder";
          return;
        }
        const sv = R[l].services;
        for (let i = 0; i < sv.length; i++) {
          if (sv[i].name === sn) {
            const rt = sv[i].routes;
            for (let j = 0; j < rt.length; j++) {
              const r = rt[j];
              const rn = typeof r === "string" ? r : r.route;
              if (rn === dn) {
                PV.textContent = typeof r === "string" ? "" : (r.price ?? "");
                delete PV.dataset.state;
                return;
              }
            }
          }
        }
        PV.textContent = SP;
        PV.dataset.state = "placeholder";
      }

      function updateBtn(): void {
        const base =
          !!nameIn &&
          !!nameIn.value.trim() &&
          validName(nameIn.value) &&
          !!phoneIn &&
          !!phoneIn.value.trim() &&
          validPhone(phoneIn.value) &&
          !!pickUpDate &&
          !!pickUpDate.value;
        // Chauffeur variant additionally requires a full location/service/dest;
        // garage variant requires the service select to be picked.
        const allFilled = HB
          ? base &&
            !!L &&
            !!L.value &&
            !!S &&
            !S.disabled &&
            !!S.value &&
            !!D &&
            !D.disabled &&
            !!D.value
          : base && (!!S && !!S.value || !!PSV);
        submitBtn.disabled = !allFilled;
        submitBtn.style.opacity = allFilled ? "1" : "0.5";
        submitBtn.style.cursor = allFilled ? "pointer" : "not-allowed";
      }

      // Listen on all relevant fields
      L?.addEventListener("change", () => {
        updateBtn();
        uS();
      });
      S?.addEventListener("change", () => {
        updateBtn();
        uD();
      });
      D?.addEventListener("change", updateBtn);
      pickUpDate?.addEventListener("change", updateBtn);
      msgIn?.addEventListener("input", updateBtn);

      // Init button state
      updateBtn();

      form.addEventListener("submit", (e: Event) => {
        e.preventDefault();
        if (!form.checkValidity() || btn.disabled) return;
        const n = nameIn?.value ?? "";
        const p = phoneIn?.value ?? "";
        const dt = pickUpDate?.value ?? "";
        let msg: string;
        let pn: string;
        let cn: string;
        if (HB && L && S && D) {
          const lt = L.options[L.selectedIndex].text;
          const st = S.options[S.selectedIndex].text;
          const dst = D.options[D.selectedIndex].value;
          pn = L.value === "italy" ? PI : PS;
          msg =
            "Hi " +
            d.SN +
            "! I would like to book a ride.\n\n*Name:* " +
            n +
            "\n*Phone:* " +
            p +
            "\n*Location:* " +
            lt +
            "\n*Service:* " +
            st +
            "\n*Date:* " +
            dt +
            "\n*Destination:* " +
            dst;
        } else {
          // Garage variant: prefer Spain number, fall back to Italy. The service
          // select + message textarea (optional) are included when filled.
          pn = PS || PI;
          msg =
            "Hi " +
            d.SN +
            "! I would like to get a quote.\n\n*Name:* " +
            n +
            "\n*Phone:* " +
            p +
            "\n*Date:* " +
            dt +
            "\n*Service:* " +
            (S && S.value ? S.options[S.selectedIndex].text : PSV);
          // Append any per-service custom fields (Origin/Destination, etc.).
          // Location-typed fields prefer the full address from their hidden input.
          document
            .querySelectorAll<HTMLInputElement>("[data-custom-field]")
            .forEach((el) => {
              let v = el.value.trim();
              if (el.hasAttribute("data-custom-location")) {
                // autoComplete.js wraps the input in .autoComplete_wrapper, so
                // the hidden field is a sibling of that wrapper, not a child —
                // resolve it by id (DropdownInput uses `<id>-location`).
                const hid = document.getElementById(
                  el.id + "-location",
                ) as HTMLInputElement | null;
                if (hid && hid.value) v = hid.value.trim();
              }
              if (v) {
                // autoComplete.js wraps location inputs in .autoComplete_wrapper,
                // so the label is not a previous sibling anymore — read aria-label
                // (set by the field component) and fall back to the input name.
                const lbl =
                  (el.getAttribute("aria-label") || el.name).trim();
                msg += "\n*" + lbl + ":* " + v;
              }
            });
          if (msgIn && msgIn.value.trim()) {
            msg += "\n*Message:* " + msgIn.value.trim();
          }
        }
        cn = pn.replace(/[\s+]/g, "");
        // Only digits survive into the wa.me path; if no phone is configured,
        // surface an error instead of silently failing.
        const digits = cn.replace(/\D/g, "");
        if (!digits) {
          if (formError) formError.style.display = "block";
          return;
        }
        window.open(
          "https://wa.me/" + digits + "?text=" + encodeURIComponent(msg),
          "_blank",
        );
      });
      // Balanced field grid: pick a column count so items pack with no empty
      // cells. Rule (user spec): 4→2+2, 5→3+2, 6→3+3, 7→4+3, 8→4+4,
      // 9→3+3+3, 10→5+5, 11→6+5 — i.e. `cols = round(N/2)`, except N=9 →3.
      // `.vehicle-fields` uses `display:contents`, so its 4 sub-fields
      // (type/make/model/year) are direct grid items counted as 4 leaf fields.
      // The submit button (form-bottom-row) is a 1-col item too — it sits the
      // same width as a field and participates in distribution. N = total
      // columns = label-fields + 1 submit. Runs after render so counts are real.
      const gform = document.querySelector<HTMLElement>(".garage-form");
      if (gform && window.matchMedia("(min-width: 992px)").matches) {
        const units = gform.querySelectorAll(
          ".booking-form-label-field",
        ).length + 1; /* +1 submit button */
        const cols = units === 9 ? 3 : Math.max(1, Math.round(units / 2));
        gform.style.setProperty(
          "grid-template-columns",
          `repeat(${cols}, minmax(0, 1fr))`,
        );
        // Submit fills trailing cells in its row (no empty space). It's the
        // final grid item, so it starts at column (units-1)%cols and spans the
        // remaining cells of that last row. If it starts a fresh row (last
        // fields row was full), (units-1)%cols === 0 → spans the whole row.
        const submit = gform.querySelector<HTMLElement>(
          ".booking-button-wrapper",
        );
        const span = cols - ((units - 1) % cols);
        if (submit) submit.style.gridColumn = `span ${span}`;
      }
    })();
  }
</script>
<script>
  // Photon address autocomplete for per-service `form_fields` entries with
  // `type: "location"` / `type: "country"` (rendered via the shared
  // DropdownInput.astro component). Bundled → external /_astro/*.js module,
  // allowed by the strict `script-src 'self'` CSP. The Photon fetch is allowed
  // by `connect-src 'self' https://photon.komoot.io`.
  import autoComplete from "@tarekraafat/autocomplete.js";

  const locationInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>("[data-photon-location]"),
  );
  if (locationInputs.length) {
    // Europe + US only — Photon's countrycode param must be repeated, not
    // comma-separated (public instance rejects comma format). Builds URL
    // dynamically to append &countrycode=XX for each country.
    // layer=street|house prefers real addresses. No lang param — public
    // instance rejects lang=es with 400. Limit 6 for a compact dropdown.
    const PHOTON_COUNTRIES = [
      "AL","AD","AT","BY","BE","BA","BG","HR","CY","CZ","DK","EE","FI","FR",
      "DE","GR","HU","IS","IE","IT","XK","LV","LI","LT","LU","MT","MD","MC",
      "ME","NL","MK","NO","PL","PT","RO","RU","SM","RS","SK","SI","ES","SE",
      "CH","TR","UA","GB","US",
    ];
    // EU + US allow-set for country-only dropdowns (same list as the address
    // countrycode bias). Photon country features carry an ISO countrycode.
    const PHOTON_COUNTRY_ALLOW = new Set(PHOTON_COUNTRIES);
    const PHOTON_BASE =
      "https://photon.komoot.io/api?limit=6&layer=street&layer=house";
    // Country-only: Photon `layer=country`, worldwide (no countrycode filter).
    const PHOTON_COUNTRY_BASE = "https://photon.komoot.io/api?limit=6&layer=country";

    locationInputs.forEach((input) => {
      const hidden = document.getElementById(
        input.id + "-location",
      ) as HTMLInputElement | null;
      // Country-only fields (Origin/Destination country on import-export) use
      // layer=country worldwide; address fields use street|house biased to EU/US.
      const isCountry = input.hasAttribute("data-country-location");
      const queryUrl = isCountry
        ? PHOTON_COUNTRY_BASE
        : PHOTON_BASE +
          "&" +
          PHOTON_COUNTRIES.map((cc) => "countrycode=" + cc).join("&");
      new autoComplete({
        selector: () => input,
        threshold: 2,
        debounce: 250,
        data: {
          src: async (query: string) => {
            if (!query || query.trim().length < 2) return [];
            const res = await fetch(
              queryUrl + "&q=" + encodeURIComponent(query.trim()),
            );
            if (!res.ok) return [];
            const json = await res.json();
            // autoComplete.js matches against top-level keys, so flatten each
            // Photon feature's nested `properties` into a flat record. Keep the
            // whole feature on `_feature` for the selection handler.
            // Country-only: Photon returns country names in the local language
            // ("España"), which won't match a typed "spain" client-side — carry
            // the raw query on `_q` so the record always matches; display uses
            // the real country name from `_feature`.
            const rows = (json.features ?? []).map((f: any) => ({
              name: f.properties?.name ?? "",
              street: f.properties?.street ?? "",
              city: f.properties?.city ?? "",
              country: f.properties?.country ?? "",
              ...(isCountry ? { _q: query.trim() } : {}),
              _feature: f,
            }));
            // Country-only: Photon returns duplicate country features — dedup by
            // country name so "United States" appears once. The `countrycode`
            // PARAM doesn't filter layer=country results, so restrict to EU + US
            // client-side via each feature's countrycode property.
            return isCountry
              ? rows
                  .filter(
                    (r, i, a) =>
                      a.findIndex((x) => x.country === r.country) === i,
                  )
                  .filter((r) =>
                    PHOTON_COUNTRY_ALLOW.has(
                      r._feature?.properties?.countrycode,
                    ),
                  )
              : rows;
          },
          keys: isCountry ? ["_q"] : ["name", "street"],
          cache: false,
        },
        resultsList: {
          element: (list: HTMLUListElement) => {
            // Runs on every open after items are appended; attach the shared
            // dropdown panel class so autocomplete reuses the nav-panel look.
            list.classList.add("dropdown-panel");
          },
          maxResults: 6,
        },
        resultItem: {
          highlight: false,
          element: (item: HTMLElement, data: { value: any }) => {
            const v = data.value;
            item.classList.add("dropdown-panel-item");
            // Country-only: just the country name (Photon sets name==country).
            const label = isCountry
              ? v.name || v.country || ""
              : [v.name, v.street, v.city, v.country]
                  .filter(Boolean)
                  .join(", ");
            item.textContent = label;
          },
        },
        events: {
          input: {
            selection: (e: Event) => {
              // autoComplete.js dispatches selection as CustomEvent with the
              // feedback object in `detail` (not `e.feedback`).
              const feedback = (e as CustomEvent).detail;
              const v = feedback?.selection?.value ?? {};
              const p = v._feature?.properties ?? v;
              const full = isCountry
                ? p.name || p.country || ""
                : [
                    p.name,
                    p.street,
                    p.housenumber,
                    p.city,
                    p.country,
                  ]
                    .filter(Boolean)
                    .join(", ");
              // autoComplete.js does NOT back-fill the input on select — show
              // the full chosen value in the visible field, and keep the
              // hidden input carrying the address for the submit handler.
              input.value = full;
              if (hidden) hidden.value = full;
              // Custom location fields carry the full address on the hidden
              // input; the submit handler appends it with its own label.
            },
          },
        },
      });
    });
  }
</script>