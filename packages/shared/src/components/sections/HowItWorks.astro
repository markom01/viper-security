---
const { pageContent } = Astro.props;
const { steps } = Astro.props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
const s = resolveLabels(pageContent, STRINGS);
const st = pageContent?.howitworks;
---

<section id="how-it-works" class="section steps-section">
  <div class="content-wrapper">
    <div data-scroll-reveal class="steps-heading-wrapper">
      <div class="subheadline-wrapper">
        <div class="subheadline-line"></div>
        <div class="subheadline">{s.howItWorks.subheadline}</div>
      </div>
      <h2 class="steps-heading">{st?.heading}</h2>
    </div>
    <div class="steps-wrapper">
      <div data-scroll-reveal class="step-item">
        <div class="step-number-wrapper">
          <div class="step-number">{s.stepNumber[0]}</div>
        </div>
        <div class="step-details-wrapper">
          <h3 class="step-title">{steps?.[0]?.title}</h3>
          <div class="step-description">{steps?.[0]?.description}</div>
        </div>
      </div>
      <div data-scroll-reveal class="step-item">
        <div class="step-number-wrapper">
          <div class="step-number">{s.stepNumber[1]}</div>
        </div>
        <div class="step-details-wrapper">
          <h3 class="step-title">{steps?.[1]?.title}</h3>
          <div class="step-description">{steps?.[1]?.description}</div>
        </div>
      </div>
      <div data-scroll-reveal class="step-item">
        <div class="step-number-wrapper">
          <div class="step-number">{s.stepNumber[2]}</div>
        </div>
        <div class="step-details-wrapper">
          <h3 class="step-title">{steps?.[2]?.title}</h3>
          <div class="step-description">{steps?.[2]?.description}</div>
        </div>
      </div>
      <div class="steps-line"></div>
    </div>
  </div>
</section>
<style>
  .steps-section .subheadline {
    color: var(--colors--gold-bright);
  }
  .steps-section .subheadline-line {
    background-color: var(--colors--gold-bright);
  }
  .steps-line {
    background-color: var(--colors--gold-bright);
    height: 1px;
    transition: width 1s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .steps-section .step-item {
      transform: none !important;
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
