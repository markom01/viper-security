---
import type { NavLink, PageContent } from "../../types";

interface Props {
  brandName?: string;
  pageContent?: PageContent;
  navItems?: NavLink[];
  ctaLabel?: string;
}

const { brandName, pageContent, navItems, ctaLabel } = Astro.props as Props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
import { ICONS } from "../../config/icons";
const s = resolveLabels(pageContent, STRINGS);
const cta = ctaLabel || s.nav.contact;
// Nav items as data. Each: { label, href, children?: [{label,href}] }.
// Default = VIPER chauffeur menu. A site passes its own via the navItems prop.
const items = navItems ?? [
  {
    label: s.nav.chauffeur,
    href: "/",
    children: [
      { label: s.nav.about, href: "/#about" },
      { label: s.nav.services, href: "/#services" },
      { label: s.nav.fleet, href: "/#fleet" },
      { label: s.nav.howItWorks, href: "/#how-it-works" },
      { label: s.nav.pricing, href: "/#pricing" },
    ],
  },
  { label: s.nav.luxuryCars, href: "/luxury-cars" },
  { label: s.nav.armouredVehicles, href: "/armoured-vehicles" },
];
---

<div role="banner" class="navbar">
  <div class="content-wrapper">
    <div class="navbar-wrapper">
      <a href="/" class="logo-link" aria-label={s.nav.homeAria}>
        <span class="brand-text">{brandName}</span>
      </a>
      <nav role="navigation" class="nav-menu-wrapper">
        <ul role="list" class="nav-menu-list">
          <li class="nav-list-item nav-list-brand">
            <a href="/" class="logo-link" aria-label={s.nav.homeAria}>
              <span class="brand-text">{brandName}</span>
            </a>
          </li>
          {
            items.map((item) =>
              item.children ? (
                <li class="nav-list-item has-dropdown">
                  <a
                    href={item.href}
                    class="nav-link dropdown-toggle"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {item.label}
                    <span
                      aria-hidden="true"
                      class="caret"
                      set:html={ICONS.caretDown}
                    />
                  </a>
                  <ul role="menu" class="chauffeur-dropdown">
                    {item.children.map((child) => (
                      <li role="none">
                        <a role="menuitem" href={child.href} class="nav-link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li class="nav-list-item">
                  <a href={item.href} class="nav-link">
                    {item.label}
                  </a>
                </li>
              ),
            )
          }
          <li class="nav-list-item desktop-button">
            <a href="/#contact" class="primary-button small">
              <div class="button-text">{cta}</div>
              <span
                aria-hidden="true"
                class="button-arrow"
                set:html={ICONS.rightArrow}
              />
            </a>
          </li>
          <li class="nav-list-item tablet-mobile-button">
            <a href="/#contact" class="secondary-button">
              <div class="button-text">{cta}</div>
              <span
                aria-hidden="true"
                class="button-arrow"
                set:html={ICONS.rightArrowPure}
              />
            </a>
          </li>
        </ul>
        <div
          class="close-menu-button"
          style="-webkit-user-select: text;"
          aria-label={s.nav.menuAria}
          role="button"
          tabindex="0"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          <div class="nav-close">
            <span aria-hidden="true" set:html={ICONS.cancel} />
          </div>
        </div>
      </nav>
      <div class="nav-buttons-wrapper">
        <div class="tablet-button">
          <a href="/#contact" class="primary-button small">
            <div class="button-text">{cta}</div>
            <span
              aria-hidden="true"
              class="button-arrow"
              set:html={ICONS.rightArrow}
            />
          </a>
        </div>
        <div
          class="open-menu-button"
          style="-webkit-user-select: text;"
          aria-label={s.nav.menuAria}
          role="button"
          tabindex="0"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          <div class="nav-open">
            <div class="menu-line"></div><div class="menu-line"></div><div
              class="menu-line"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .brand-text {
    font-family: var(--font-families--accent-font);
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: var(--colors--gold);
    white-space: nowrap;
  }
  .nav-menu-list {
    list-style: none;
  }
  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .caret {
    display: inline-flex;
    transition: transform 0.2s ease;
  }
  .chauffeur-dropdown {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Mobile: dropdown items shown inline (full-screen menu), no hover panel */
  @media (max-width: 991px) {
    .nav-menu-wrapper {
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.3s ease,
        visibility 0.3s ease;
    }
    .navbar[data-nav-open] .nav-menu-wrapper {
      visibility: visible;
      opacity: 1;
    }
    .chauffeur-dropdown {
      padding: 8px 0 0 12px;
    }
    .chauffeur-dropdown .nav-link {
      padding: 6px 0;
      opacity: 0.85;
    }
  }
  /* Desktop: nav inline, not overlay; Chauffeur hover dropdown */
  @media (min-width: 992px) {
    .nav-menu-wrapper {
      position: static;
      min-width: auto;
      min-height: auto;
      background: transparent;
      padding: 0;
      overflow: visible;
      inset: auto;
      display: flex;
      align-items: center;
    }
    .nav-menu-list {
      flex-direction: row;
    }
    .has-dropdown {
      position: relative;
    }
    .chauffeur-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 200px;
      background: var(--colors--pure);
      border: 1px solid var(--colors--cloud);
      border-radius: 12px;
      padding: 8px 0;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition:
        opacity 0.2s ease,
        visibility 0.2s ease,
        transform 0.2s ease;
    }
    .has-dropdown:hover .chauffeur-dropdown,
    .has-dropdown:focus-within .chauffeur-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .has-dropdown:hover .caret,
    .has-dropdown:focus-within .caret {
      transform: rotate(180deg);
    }
    .chauffeur-dropdown .nav-link {
      padding: 8px 20px;
      white-space: nowrap;
    }
    .nav-list-brand,
    .close-menu-button,
    .tablet-mobile-button {
      display: none !important;
    }
    .open-menu-button {
      display: none !important;
    }
  }
</style>
<script is:inline>
  (function () {
    var navbar = document.querySelector(".navbar");
    if (!navbar) return;
    document.addEventListener("click", function (e) {
      if (e.target.closest(".open-menu-button")) {
        navbar.setAttribute("data-nav-open", "");
      }
      if (e.target.closest(".close-menu-button")) {
        navbar.removeAttribute("data-nav-open");
      }
      // Close menu when a nav link is tapped
      if (e.target.closest(".nav-link")) {
        navbar.removeAttribute("data-nav-open");
      }
    });
  })();
</script>
