---
import type { PageContent } from "../../types";
const { pageContent } = Astro.props as { pageContent?: PageContent };
import { getImage } from "astro:assets";
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
import { ICONS } from "../../config/icons";
const s = resolveLabels(pageContent, STRINGS);
const stats = pageContent?.stats;
const items = stats?.items;
// Optimize the stats background via the asset pipeline, then keep feeding it
// into the CSS var so the existing section styles stay untouched.
const statsBg = stats?.image ? await getImage({ src: stats.image }) : null;
---

<section
  id="stats"
  class="section home-metrics-section"
  style={`--metrics-bg: url(${statsBg?.src})`}
>
  <div class="content-wrapper">
    <div class="metrics-content-wrapper">
      <div data-scroll-reveal class="metrics-heading-wrapper">
        <h2 class="metrics-heading">{s.stats.heading}</h2>
        <div class="metrics-subheading">{stats?.subheading}</div>
      </div>
      <div data-scroll-reveal class="metrics-button-wrapper">
        <a href="/#contact" class="secondary-button">
          <div class="button-text">{s.stats.button}</div>
          <span
            aria-hidden="true"
            class="button-arrow"
            set:html={ICONS.rightArrowPure}
          />
        </a>
      </div>
      <div class="metrics-wrapper">
        {items?.map((item) => (
          <div data-scroll-reveal class="metric-item">
            <div class="metric-number">{item.label}</div>
            <div class="metric-title">{item.title}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .metric-number {
    color: var(--colors--gold-bright);
  }
</style>
