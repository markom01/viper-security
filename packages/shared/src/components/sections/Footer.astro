---
import type { NavLink, PageContent } from "../../types";

interface Props {
  pageContent?: PageContent;
  footerItems?: NavLink[];
  brandName?: string;
  brandLogoSrc?: string;
  tagline?: string;
  phoneItaly?: string;
  phoneSpain?: string;
  /** Third display number (e.g. the WhatsApp line that receives form enquiries). */
  phoneSpainWhatsapp?: string;
  /** Social profiles. Verified real handles per site; bare roots disabled. */
  social?: { icon: string; href: string; label: string }[];
  /** CMS-editable company/address block under the logo. Falls back to pageContent.footer_company_info. */
  footerCompanyInfo?: string;
}

const { pageContent, footerItems, brandName, brandLogoSrc, tagline, phoneItaly, phoneSpain, phoneSpainWhatsapp, social, footerCompanyInfo: footerCompanyInfoProp } = Astro.props as Props;
import STRINGS from "../../config/strings";
import { resolveLabels } from "../../config/labels";
const s = resolveLabels(pageContent, STRINGS);
const b = pageContent?.branding;
const thisYear = new Date().getFullYear();
// Footer links as data. Default = VIPER menu. A site passes its own via footerItems.
const links = footerItems ?? [
  { label: s.nav.chauffeur, href: "/" },
  { label: s.nav.luxuryCars, href: "/luxury-cars" },
  { label: s.nav.armouredVehicles, href: "/armoured-vehicles" },
  { label: s.nav.about, href: "#about" },
  { label: s.nav.services, href: "#services" },
  { label: s.nav.fleet, href: "#fleet" },
  { label: s.nav.howItWorks, href: "#how-it-works" },
  { label: s.nav.pricing, href: "#pricing" },
  { label: s.nav.contact, href: "#contact" },
  { label: "Privacy Policy", href: "/privacy-policy" },
];

const cleanPhone = (phone?: string) => (phone || "").replace(/\D/g, "");
const phoneSep = s.footer.phoneSeparator;
// CMS-editable company/address block under the logo (shared footer: only
// renders when the site provides data — hidden on VIPER until it has data).
const footerCompanyInfo = (footerCompanyInfoProp ?? pageContent?.footer_company_info ?? "").trim();
const mapEmbedUrl = pageContent?.map_embed_url;
const isAllowedMapUrl = (u?: string) => {
  try {
    const url = new URL(u || "");
    return (url.origin === "https://www.google.com" && url.pathname.startsWith("/maps")) || url.origin === "https://maps.google.com";
  } catch { return false; }
};
---

<footer class="footer">
  <div class="content-wrapper">
    <div class="footer-content-wrapper">
      <div class="footer-middle">
        <div class="footer-text-wrapper">
          <a href="/" class="logo-link" aria-label={brandName ? `${brandName} home` : "Home"}>
            {brandLogoSrc ? (
              <img class="brand-logo" src={brandLogoSrc} alt={brandName ? `${brandName} logo` : "Site logo"} width="48" height="48" loading="lazy" decoding="async" />
            ) : (
              <span class="brand-text">{brandName}</span>
            )}
          </a>
          {footerCompanyInfo ? (
            <p class="footer-company-info">{footerCompanyInfo}</p>
          ) : null}
          <p class="pure-text">
            {
              [phoneItaly, phoneSpain, phoneSpainWhatsapp].filter(Boolean).map((phone, i) => (
                <>
                  {i > 0 ? phoneSep : null}
                  <a
                    href={`https://wa.me/${cleanPhone(phone)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`WhatsApp ${phone}`}
                    class="phone-wa-link">{phone}</a
                  >
                </>
              ))
            }
          </p>
          {
            social?.length ? (
              <div class="social-links-wrapper">
                {social.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                    aria-label={link.label}
                  >
                    <img
                      src={`/images/${link.icon}`}
                      width="20"
                      height="20"
                      loading="lazy"
                      decoding="async"
                      alt=""
                      aria-hidden="true"
                    />
                  </a>
                ))}
              </div>
            ) : null
          }
        </div>
        <div class="footer-links-wrapper">
          <div class="footer-links-column">
            <h2 class="footer-links-heading">{s.footer.pagesHeading}</h2>
            <div class="footer-links">
              {
                links.map((l) => (
                  <a href={l.href} class="footer-link">
                    {l.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
        {
          isAllowedMapUrl(mapEmbedUrl) && (
            <div class="footer-map-wrapper">
              <iframe
                src={mapEmbedUrl}
                width="100%"
                style="border:0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Location map"
                allowfullscreen
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</footer>
<style>
  .footer-luxury-tagline {
    font-family: var(--font-families--accent-font);
    font-size: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--colors--gold-bright);
    margin-top: 6px;
  }
  .brand-text {
    font-family: var(--font-families--accent-font);
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: var(--colors--gold-bright);
    white-space: nowrap;
  }
  .logo-link {
    display: inline-flex;
    align-items: center;
  }
  .brand-logo {
    display: block;
    height: 100%;
    width: auto;
    max-width: 150px;
    object-fit: contain;
  }
  .footer-motto {
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--colors--slate);
    margin-top: 4px;
  }
  .footer-company-info {
    font-size: 0.85rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--colors--slate);
    margin: 0;
    white-space: pre-line;
  }
  .phone-wa-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .phone-wa-link:hover,
  .phone-wa-link:focus-visible {
    color: var(--colors--gold-bright);
    text-decoration: underline;
  }
  .footer-link:hover {
    color: var(--colors--gold-bright);
  }
</style>
