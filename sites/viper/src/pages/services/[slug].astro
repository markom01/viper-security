---
// VIPER service detail pages — thin data-collector. All rendering lives in the
// shared ServicePage renderer (@garage/shared), so VIPER + DBC service pages
// cannot drift. This file only gathers VIPER-specific collections and passes
// them through with VIPER's chrome/identity.
import BaseLayout from "@garage/shared/layouts/BaseLayout.astro";
import ServicePage from "@garage/shared/sections/ServicePage.astro";

import { getCollection, getEntry } from "astro:content";
import { SITE_NAME } from "@garage/shared/config/strings";
import { resolveTemplates } from "@garage/shared/config/templates";

export async function getStaticPaths() {
  const [servicesEntry] = await getCollection("services");
  const offerings = servicesEntry?.data?.offerings || [];
  return offerings.map((o) => ({
    params: { slug: o.slug ?? o.title.toLowerCase().replace(/[^a-z0-9]+/g, "-") },
    props: { offering: o },
  }));
}

const { offering } = Astro.props;

const [heroEntry] = await getCollection("hero");
const [howItWorksEntry] = await getCollection("how-it-works");
const fleetEntries = await getCollection("fleet");
const [membershipEntry] = await getCollection("membership");
const [pageContentEntry] = await getCollection("page-content");

const pageContent = pageContentEntry?.data || {};
const bd = (pageContent as any)?.booking_data;
const vehicleName = (pageContent as any)?.vehicle_name;

const hourlyEntry = await getEntry("pricing", "hourly");

const hero = heroEntry?.data || {};
const howItWorks = howItWorksEntry?.data || {};
const hourly = hourlyEntry?.data || {};
const membership = membershipEntry?.data || {};

const allFleetFeatures = [
  ...new Set(fleetEntries.flatMap((e) => e.data.features || [])),
];
const fleetFeaturesText =
  allFleetFeatures.length > 0
    ? allFleetFeatures.length === 1
      ? allFleetFeatures[0] + "."
      : allFleetFeatures.slice(0, -1).join(", ") +
        ", and " +
        allFleetFeatures.slice(-1)[0] +
        "."
    : "";

// Site-global chrome + per-offering seo. VIPER always renders the full fleet
// collection (RHS), so hasFleet=true.
const mergedContent: any = {
  ...pageContent,
  seo: offering.seo
    ? { ...((pageContent as any)?.seo || {}), ...(offering.seo as any) }
    : (pageContent as any)?.seo,
};
const heroFields: any = offering.hero || {};
// Ensure og:image is never an SVG (BaseLayout skips SVG preload/meta). Prefer
// offering hero image (raster), else fall back to site og (og-viper.webp).
if (!mergedContent.seo) mergedContent.seo = {};
if (!mergedContent.seo.image || mergedContent.seo.image.endsWith(".svg")) {
  mergedContent.seo.image = heroFields.image || (pageContent as any)?.seo?.image || "/images/og-viper.webp";
}

// Resolve {placeholders} in service-specific prose + SEO/JSON-LD (mirrors index.astro)
if (heroFields.subtitle)
  heroFields.subtitle = resolveTemplates(heroFields.subtitle, bd, SITE_NAME, vehicleName);
if ((offering as any).description)
  (offering as any).description = resolveTemplates((offering as any).description, bd, SITE_NAME, vehicleName);
if (mergedContent.seo?.title)
  mergedContent.seo.title = resolveTemplates(mergedContent.seo.title, bd, SITE_NAME, vehicleName);
if (mergedContent.seo?.description)
  mergedContent.seo.description = resolveTemplates(mergedContent.seo.description, bd, SITE_NAME, vehicleName);
if (mergedContent.jsonld?.org_description)
  mergedContent.jsonld.org_description = resolveTemplates(
    mergedContent.jsonld.org_description,
    bd,
    SITE_NAME,
    vehicleName,
  );
if (mergedContent.jsonld?.org_name)
  mergedContent.jsonld.org_name = resolveTemplates(
    mergedContent.jsonld.org_name,
    bd,
    SITE_NAME,
    vehicleName,
  );
---

<BaseLayout
  pageContent={mergedContent}
  brandName={hero.brand_name || SITE_NAME}
  ogLocale="en_US"
  preloadImage={heroFields.image}
>
  <ServicePage
    offering={offering}
    pageContent={mergedContent}
    region="VIPER"
    hero={{
      subtitle: heroFields.subtitle,
      cta_text: heroFields.cta_text,
      tagline: offering.title || heroFields.tagline,
      image: heroFields.image,
      phoneItaly: hero.phone_italy,
      phoneSpain: hero.phone_spain,
    }}
    fleetVehicles={fleetEntries}
    fleetFeaturesText={fleetFeaturesText}
    hasFleet
    howItWorksSteps={howItWorks.steps}
    showPricing
    hourly={hourly}
    showMembership
    membershipTiers={membership.tiers}
  />
</BaseLayout>