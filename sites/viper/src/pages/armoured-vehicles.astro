---
import BaseLayout from "@garage/shared/layouts/BaseLayout.astro";
import STRINGS, { SITE_NAME } from "@garage/shared/config/strings";
const s = STRINGS;

const pageContent = {
  seo: {
    title: `${SITE_NAME} — Armoured Vehicles`,
    description: "VIPER Security armoured vehicles.",
  },
};
---

<BaseLayout pageContent={pageContent} brandName={SITE_NAME}>
  <section class="placeholder-section">
    <div class="content-wrapper">
      <h1>{s.nav.armouredVehicles}</h1>
      <p>Coming soon.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .placeholder-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 24px;
    color: var(--colors--ivory);
  }
</style>
