---
import BaseLayout from "@garage/shared/layouts/BaseLayout.astro";
---

<BaseLayout pageContent={{}}>
  <div style={{ maxWidth: "48rem", margin: "0 auto", padding: "4rem 24px" }}>
    <h1>Privacy Policy</h1>
    <p>
      This page explains what data VIPER Security collects through this website
      and how it is used.
    </p>

    <section>
      <h2>What we collect</h2>
      <p>
        The booking form on our home page asks for your name, phone number and a
        message describing your enquiry.
      </p>
    </section>

    <section>
      <h2>How we use it</h2>
      <p>
        We use this information only to respond to your enquiry and arrange your
        chauffeur service. Sending the form opens a WhatsApp message to our
        chauffeur using the details you enter — the message is delivered directly
        via WhatsApp and is not stored on our website.
      </p>
    </section>

    <section>
      <h2>Sharing</h2>
      <p>
        We do not sell, trade, or share your personal information with third
        parties.
      </p>
    </section>

    <section>
      <h2>Contact</h2>
      <p>
        To ask about your data or this policy, contact us using the phone numbers
        listed on our site.
      </p>
    </section>
  </div>
</BaseLayout>