{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "public", "node_modules"],
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@garage/shared/*": ["../../packages/shared/src/*"]
    },
    "plugins": [{ "name": "@astrojs/ts-plugin" }]
  }
}
