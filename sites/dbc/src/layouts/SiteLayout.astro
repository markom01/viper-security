---
// DB Custom Garage per-site layout — wraps the shared BaseLayout.
// Centralizes the DBC chrome (brandName, navItems, footerItems, ctaLabel)
// so pages only pass `pageContent` + slot content.
import BaseLayout from "@garage/shared/layouts/BaseLayout.astro";
import type { PageContent } from "@garage/shared/types";
import { buildNav, buildFooterNav } from "../data/nav";

interface Props {
  /** page-content collection entry data (seo, jsonld, labels, booking_data, ...). */
  pageContent: PageContent;
  /** Open Graph locale (defaults to shared en_US; garage serves ES market). */
  ogLocale?: string;
  /** LCP hero image to <link preload> in <head>. */
  preloadImage?: string;
  /** Emit noindex robots meta (e.g. placeholder pages). */
  noindex?: boolean;
  /** Real social profiles for the footer. */
  social?: { icon: string; href: string; label: string }[];
}

const { pageContent, ogLocale, preloadImage, noindex, social } = Astro.props;

// Default footer socials — verified real handles (Instagram @dbcustomgarage,
// WhatsApp 34617201441 per RESEARCH-DBC). Pages may override.
const defaultSocial = [
  {
    icon: "instagram-logo.svg",
    href: "https://www.instagram.com/dbcustomgarage/",
    label: "Follow us on Instagram",
  },
  {
    icon: "whatsapp-logo.svg",
    href: "https://wa.me/34670038541",
    label: "Contact us on WhatsApp",
  },
  {
    icon: "email-logo.svg",
    href: "mailto:dbcustomgarage@gmail.com",
    label: "Email us at dbcustomgarage@gmail.com",
  },
];
const footerSocials = social ?? defaultSocial;

// Sveltia CMS rejects dotted field names — CMS saves underscore keys,
// normalize to dot-path so buildNav AND shared-section resolveLabels lookups
// (which split on ".") both work unchanged.
const normalizeKey = (k: string) => k.replace(/_/g, ".");
const labels: Record<string, string> = Object.fromEntries(
  Object.entries(pageContent?.labels ?? {}).map(([k, v]) => [
    normalizeKey(k),
    String(v),
  ]),
);

const normalizedContent: PageContent = {
  ...pageContent,
  labels,
};

const navItems = buildNav(labels);
const footerItems = buildFooterNav(labels);
const ctaLabel = labels["nav.contact"];
// Single CMS source for header + footer logo: site globals branding.logo
// (editable in CMS under Site Globals → Branding). Falls back to the
// checked-in DBC badge so pages render even if the field is empty.
const brandLogoSrc = normalizedContent?.branding?.logo || "/images/cms/Logo.png";
---

<BaseLayout
  pageContent={normalizedContent}
  brandLogoSrc={brandLogoSrc}
  navItems={navItems}
  footerItems={footerItems}
  ctaLabel={ctaLabel}
  ogLocale={ogLocale}
  preloadImage={preloadImage}
  noindex={noindex}
  social={footerSocials}
>
  <slot />
</BaseLayout>
