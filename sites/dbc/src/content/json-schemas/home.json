{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "db-custom-garage/home",
  "title": "DBC Home CMS page",
  "description": "Canonical DBC page structure. home / services / site all share the same section blocks (seo, stats, cta, bottomcta, about, branding, labels) on top of page-specific fields. gallery + privacy are exempt.",
  "type": "object",
  "properties": {
    "hero": {
      "type": "object",
      "properties": {
        "brand_name": { "type": "string" },
        "tagline": { "type": "string" },
        "subtitle": { "type": "string" },
        "cta_text": { "type": "string" },
        "hero_image": { "type": "string" },
        "phone_italy": { "type": "string" },
        "phone_spain": { "type": "string" }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "properties": {
        "offerings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "image": { "type": "string" },
              "slug": { "type": "string" }
            },
            "required": ["region", "title", "description"],
            "additionalProperties": false
          }
        }
      },
      "required": ["offerings"],
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "theme_color": { "type": "string" },
        "image": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": ["object", "null"],
      "properties": {
        "heading": { "type": "string" },
        "subheading": { "type": "string" },
        "image": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "label": { "type": "string" }, "title": { "type": "string" } },
            "required": ["label", "title"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cta": {
      "type": ["object", "null"],
      "properties": {
        "heading": { "type": "string" },
        "text": { "type": "string" },
        "image": { "type": "string" }
      },
      "additionalProperties": false
    },
    "bottomcta": {
      "type": ["object", "null"],
      "properties": {
        "heading": { "type": "string" },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "title": { "type": "string" }, "text": { "type": "string" } },
            "required": ["title", "text"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "about": {
      "type": ["object", "null"],
      "properties": {
        "heading": { "type": "string" },
        "text": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "branding": {
      "type": ["object", "null"],
      "properties": {
        "luxury_without_limits": { "type": "string" },
        "professional_discreet_reliable": { "type": "string" }
      },
      "additionalProperties": false
    },
    "labels": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "string" }
    }
  },
  "required": ["hero", "services"],
  "additionalProperties": false
}
