---
// DB Custom Garage privacy policy — legal compliance (GDPR/EU).
// Body is CMS-editable markdown (src/content/privacy/content.md); this page
// renders it through the per-site SiteLayout.
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../config/site";
import { getCollection, render } from "astro:content";
import AboutSection from "@garage/shared/sections/AboutSection.astro";

const [policy] = await getCollection("privacy");
const { Content } = policy ? await render(policy) : { Content: undefined };

const galleryEntries = await getCollection("gallery");
const privacyCarousel = galleryEntries.slice(0, 5).map((e) => (e.data as { image: string }).image);

const pageContent = {
  jsonld: {
    org_name: site.name,
    org_url: site.url,
    webSiteName: site.name,
    webSiteUrl: site.url,
  },
  seo: {
    title: `Privacy Policy | ${site.name}`,
    description:
      "How DB Custom Garage collects, uses, and protects your personal data when you use our website or contact us.",
    theme_color: site.themeColor,
    image: "/images/og-dbc.webp",
  },
};
---

<SiteLayout pageContent={pageContent} ogLocale="en_US">
  <AboutSection pageContent={pageContent} images={privacyCarousel} />
  <div style={{ maxWidth: "48rem", margin: "0 auto", padding: "4rem 24px" }}>
    <article>
      {Content ? (
        <>
          <h1>{policy.data.heading ?? "Privacy Policy"}</h1>
          <Content />
        </>
      ) : (
        <>
          <h1>Privacy Policy</h1>
          <p>This policy is being updated. Please check back shortly.</p>
        </>
      )}
    </article>
  </div>
</SiteLayout>

<style>
  article :global(h1) {
    font-family: var(--font-families--accent-font);
    color: var(--colors--ivory);
    margin-bottom: 16px;
  }
  article :global(h2) {
    font-family: var(--font-families--accent-font);
    color: var(--colors--gold);
    margin: 32px 0 12px;
  }
  article :global(p),
  article :global(li) {
    color: var(--colors--cloud);
    line-height: 1.6;
  }
  article :global(ul) {
    padding-left: 24px;
    margin: 8px 0;
  }
</style>
