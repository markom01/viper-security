---
import { getCollection, getEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../config/site";
import ServicePage from "@garage/shared/sections/ServicePage.astro";
import { assembleService } from "@garage/shared/lib/assemble";
import { SITE_NAME } from "@garage/shared/config/strings";
import { slugify } from "@garage/shared/lib/slugify";

export async function getStaticPaths() {
  const serviceEntries = await getCollection("service");
  return serviceEntries.map((entry) => ({
    params: { slug: entry.data.slug ?? slugify(entry.data.title) },
    props: { offering: entry.data },
  }));
}

const { offering } = Astro.props as { offering: import("@garage/shared/content/types").ServiceDetailData };
const siteGlobals = (await getEntry("site", "content"))!.data;
const homeContent = (await getEntry("home", "content"))!.data;

// Per-service fleet vehicles — mapped from offering.fleet[] to shared FleetEntry shape.
// Built before assembleService so the assembler can derive fleetFeaturesText (VIPER symmetry).
const fleetVehicles = (offering.fleet || []).map((f) => ({
  id: `${offering.slug ?? offering.title}-${f.name}`,
  collection: "fleet" as const,
  data: f,
}));

const a = assembleService({
  offering, siteGlobals, home: homeContent, siteName: SITE_NAME,
  fleetVehicles,
  hasFleet: !!offering.fleet?.length,
  howItWorksSteps: siteGlobals.howItWorksSteps,
});
// Apply DBC per-service fleet heading override (assembler leaves this to the template)
if (offering.fleet_section?.heading) {
  a.pageContent.fleet = { ...(a.pageContent.fleet || {}), heading: offering.fleet_section.heading };
}

const pageContent = a.pageContent;
const hasFleet = !!offering.fleet?.length;
const fleetFeaturesText = a.fleetFeaturesText;
---

<SiteLayout pageContent={pageContent} ogLocale="en_US" preloadImage={a.hero.image}>
  <ServicePage
    offering={a.offering}
    pageContent={pageContent}
    region="Garage"
    hero={{
      subtitle: a.hero.subtitle, cta_text: a.hero.cta_text,
      tagline: offering.title || a.hero.tagline, image: a.hero.image,
      phoneSpain: site.whatsappNumber, fleetHref: "/gallery", presetService: offering.title,
    }}
    fleetVehicles={fleetVehicles}
    fleetFeaturesText={fleetFeaturesText}
    hasFleet={hasFleet}
    ctaAnchorId="start-a-build"
    bottomCtaAnchorId="your-dream-car"
    howItWorksSteps={a.howItWorksSteps}
    showPricing={false}
    showMembership={false}
  />
</SiteLayout>
