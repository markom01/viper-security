---
// DBC service detail pages — thin data-collector. All rendering lives in the
// shared ServicePage renderer (@garage/shared), so VIPER + DBC service pages
// cannot drift. This file only gathers DBC-specific collections and passes
// them through with DBC's chrome/identity.
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../config/site";

import ServicePage from "@garage/shared/sections/ServicePage.astro";

export async function getStaticPaths() {
  const [servicesEntry] = await getCollection("services");
  const offerings = servicesEntry?.data?.offerings || [];
  return offerings.map((o) => ({
    params: { slug: o.slug ?? o.title.toLowerCase().replace(/[^a-z0-9]+/g, "-") },
    props: { offering: o },
  }));
}

const { offering } = Astro.props;

const [pageContentEntry] = await getCollection("page-content");
const [howItWorksEntry] = await getCollection("how-it-works");

const howItWorks = howItWorksEntry?.data || {};
const baseContent = pageContentEntry?.data || {};

// Site-global chrome + identity only. Per-service stats/cta overrides +
// hero image are merged in the shared ServicePage renderer.
// Per-service Fleet heading/subheadline override (import/export: "Currently
// Selling" instead of the site-global "Our Fleet") — merged only when the
// offering provides it; other services keep the site-wide fleet copy.
const fleetSection = offering.fleet_section || {};
const pageContent = {
  ...baseContent,
  seo: offering.seo || baseContent?.seo,
  ...((fleetSection.heading || fleetSection.subheadline) && {
    fleet: {
      ...(baseContent?.fleet || {}),
      ...(fleetSection.heading ? { heading: fleetSection.heading } : {}),
    },
    labels: {
      ...(baseContent?.labels || {}),
      ...(fleetSection.subheadline
        ? { "fleet.subheadline": fleetSection.subheadline }
        : {}),
    },
  }),
};

// Per-service fleet vehicles — mapped to the shared FleetEntry shape.
const fleetVehicles = (offering.fleet || []).map((f) => ({
  id: `${offering.slug ?? offering.title}-${f.name}`,
  collection: "fleet" as const,
  data: f,
}));
const allFleetFeatures = [...new Set((offering.fleet || []).flatMap((f) => f.features || []))];
const fleetFeaturesText =
  allFleetFeatures.length > 0
    ? allFleetFeatures.length === 1
      ? allFleetFeatures[0] + "."
      : allFleetFeatures.slice(0, -1).join(", ") + ", and " + allFleetFeatures.slice(-1)[0] + "."
    : "";
const hasFleet = !!offering.fleet?.length;
const heroFields = offering.hero || {};
---

<SiteLayout pageContent={pageContent} ogLocale="en_US" preloadImage={heroFields.image}>
  <ServicePage
    offering={offering}
    pageContent={pageContent}
    region="Garage"
    hero={{
      subtitle: heroFields.subtitle,
      cta_text: heroFields.cta_text,
      tagline: heroFields.tagline,
      image: heroFields.image,
      phoneSpain: site.whatsappNumber,
      fleetHref: "/gallery",
      presetService: offering.title,
    }}
    fleetVehicles={fleetVehicles}
    fleetFeaturesText={fleetFeaturesText}
    hasFleet={hasFleet}
    howItWorksSteps={howItWorks.steps}
  />
</SiteLayout>