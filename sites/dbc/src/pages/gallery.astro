---
import { getCollection, getEntry } from "astro:content";
import { getImage } from "astro:assets";
import { imageDims } from "@garage/shared/lib/imageDims.ts";
import SiteLayout from "../layouts/SiteLayout.astro";
import Gallery from "@garage/shared/sections/Gallery.astro";
import {
  resolveGalleryItems,
  buildGallerySections,
} from "@garage/shared/lib/gallery.ts";
import STRINGS from "@garage/shared/config/strings";
import { resolveLabels } from "@garage/shared/config/labels";

// Full CMS site globals (jsonld, labels, booking_data) so Nav/Footer/JSON-LD
// carry dbc identity — NOT the shared VIPER fallbacks. Gallery-specific SEO
// overrides the CMS title/description for this page.
const [siteEntry] = [await getEntry("site", "content")];
const siteGlobals = siteEntry?.data;
const pageContent = {
  ...(siteGlobals || {}),
  seo: {
    title: "DB Custom Garage — Gallery",
    description:
      "Browse our latest custom builds, restorations, and performance projects.",
    theme_color: siteGlobals?.seo?.theme_color ?? "#000000",
    image: "/images/cms/Logo.png",
  },
};

// DBC CMS stores underscore keys (Sveltia rejects dots); normalize to dot-path
// like SiteLayout does, so resolveLabels can match STRINGS keys.
const normalizeKey = (k: string) => k.replace(/_/g, ".");
const normalizedLabels = Object.fromEntries(
  Object.entries(pageContent?.labels ?? {}).map(([k, v]) => [
    normalizeKey(k),
    String(v),
  ]),
);
const s = resolveLabels({ ...pageContent, labels: normalizedLabels }, STRINGS);

// CMS-editable gallery images via the shared pipeline (same helper VIPER
// uses). Ordered sections keep the existing 5 defs verbatim — per-category
// grids so PhotoSwipe nav stays within the group; empty groups are skipped.
const galleryItems = await resolveGalleryItems(await getCollection("gallery"), {
  imageDims,
  getImage,
});

// Ordered gallery sections. Empty groups (e.g. auction before
// photos exist) are skipped so the page doesn't show a bare heading.
const sections = buildGallerySections(galleryItems, [
  { key: "brand", title: s.gallery.brand },
  { key: "supercar", title: s.gallery.supercar },
  { key: "customizing", title: s.gallery.customizing },
  { key: "auction", title: s.gallery.auction },
  { key: "all-builds", title: s.gallery["all-builds"] },
]);
---

<SiteLayout pageContent={pageContent} ogLocale="en_US">
  <Gallery sections={sections} heading={s.gallery.heading} subheadline={s.gallery.subheadline} />
</SiteLayout>
