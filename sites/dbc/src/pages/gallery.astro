---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import { imageDims } from "@garage/shared/lib/imageDims.ts";
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../config/site";

// Full CMS page-content (jsonld, labels, booking_data) so Nav/Footer/JSON-LD
// carry dbc identity — NOT the shared VIPER fallbacks. Gallery-specific SEO
// overrides the CMS title/description for this page.
const [pageContentEntry] = await getCollection("page-content");
const pageContent = {
  ...(pageContentEntry?.data || {}),
  seo: {
    title: "DB Custom Garage — Gallery",
    description:
      "Browse our latest custom builds, restorations, and performance projects.",
    theme_color: site.themeColor,
    image: "/images/og-dbc.webp",
  },
};

// CMS-editable gallery images, grouped by service category. The lightbox
// reuses the original asset (sources are already ~1600px; a separate width
// cap only duplicates files). Each category renders its own masonry grid, so
// PhotoSwipe nav stays within the group.
const galleryItems = await Promise.all(
  (await getCollection("gallery")).map(async (item) => {
    const src = item.data.image;
    // Served URL for the lightbox + anchor href; intrinsic dims for PhotoSwipe.
    // `src` may be ImageMetadata (legacy) or a public path string — probe dims
    // for the latter since Astro treats public URLs as remote.
    const dims = await imageDims(src);
    const optimized = await getImage({ src, width: dims.width, height: dims.height });
    return {
      id: item.id,
      category: item.data.category,
      alt: item.data.alt || item.data.name,
      width: dims.width,
      height: dims.height,
      href: optimized.src,
      image: src,
    };
  }),
);

// Ordered gallery sections. Empty groups (e.g. auction, import-export before
// photos exist) are skipped so the page doesn't show a bare heading.
const sections = [
  { key: "brand", title: "Brand & Home" },
  { key: "supercar", title: "Supercar Transport" },
  { key: "customizing", title: "Customizing & Design" },
  { key: "auction", title: "Auction & Sale" },
  { key: "import-export", title: "Import & Export" },
  { key: "all-builds", title: "All Builds" },
].map((section) => ({
  ...section,
  items: galleryItems.filter((item) => item.category === section.key),
})).filter((section) => section.items.length > 0);
---

<SiteLayout pageContent={pageContent}>
  <section class="gallery-section">
    <div class="content-wrapper">
      <header class="gallery-header">
        <h1>Gallery</h1>
        <p>Selected builds from our garage.</p>
      </header>
      {
        sections.map((section) => (
          <section class="gallery-group">
            <h2 class="gallery-group-title">{section.title}</h2>
            <div class="masonry" data-masonry data-gallery>
              {
                section.items.map((item) => (
                  <div class="masonry-item">
                    <a
                      href={item.href}
                      class="gallery-item"
                      data-pswp-width={item.width}
                      data-pswp-height={item.height}
                      aria-label={item.alt}
                    >
                      <Image
                        src={item.image}
                        alt={item.alt}
                        width={item.width}
                        height={item.height}
                        loading="lazy"
                        decoding="async"
                        widths={[480, 768]}
                        sizes="(min-width: 991px) 33vw, (min-width: 640px) 50vw, 100vw"
                      />
                    </a>
                  </div>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .gallery-section {
    padding: 80px 0 100px;
  }
  .gallery-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .gallery-header h1 {
    font-family: var(--font-families--accent-font);
    font-size: var(--desktop-heading-sizes--h1);
    color: var(--colors--ivory);
    margin-bottom: 12px;
  }
  .gallery-header p {
    color: var(--colors--slate);
    max-width: 560px;
    margin: 0 auto;
  }
  .gallery-group + .gallery-group {
    margin-top: 56px;
  }
  .gallery-group-title {
    font-family: var(--font-families--accent-font);
    font-size: var(--desktop-heading-sizes--h3);
    color: var(--colors--gold);
    text-align: center;
    margin-bottom: 24px;
  }
  /* Frame the grid: cap width + center, instead of edge-to-edge */
  .masonry {
    max-width: 1160px;
    margin: 0 auto;
  }
  .masonry-item {
    width: 33.333%;
    /* Horizontal gap: padded inside the item so masonry's column math stays
       exact (no `gutter` option — a px gutter fights percentage widths). */
    padding: 0 10px;
    margin-bottom: 20px;
  }
  .masonry-item a {
    display: block;
  }
  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .masonry-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
  }
  @media (max-width: 991px) {
    .masonry-item {
      width: 50%;
    }
  }
  @media (max-width: 639px) {
    .masonry-item {
      width: 100%;
    }
  }
</style>

<script>
  import Masonry from "masonry-layout";
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/dist/photoswipe.css";

  document.querySelectorAll("[data-masonry]").forEach((grid) => {
    const msnry = new Masonry(grid, {
      itemSelector: ".masonry-item",
      columnWidth: ".masonry-item",
      percentPosition: true,
    });
    let t: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(t);
      t = setTimeout(() => msnry.layout(), 100);
    });
  });

  // `gallery: "[data-gallery]"` matches every category grid; each becomes its
  // own PhotoSwipe gallery, so arrow nav stays within the current group.
  const lightbox = new PhotoSwipeLightbox({
    gallery: "[data-gallery]",
    children: "a",
    pswpModule: () => import("photoswipe"),
  });
  lightbox.init();
</script>
