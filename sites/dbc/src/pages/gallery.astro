---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../config/site";

// Full CMS page-content (jsonld, labels, booking_data) so Nav/Footer/JSON-LD
// carry dbc identity — NOT the shared VIPER fallbacks. Gallery-specific SEO
// overrides the CMS title/description for this page.
const [pageContentEntry] = await getCollection("page-content");
const pageContent = {
  ...(pageContentEntry?.data || {}),
  seo: {
    title: "DB Custom Garage — Gallery",
    description:
      "Browse our latest custom builds, restorations, and performance projects.",
    theme_color: site.themeColor,
  },
};

// CMS-editable gallery images. Full-res original is served for the PhotoSwipe
// lightbox (getImage without width/height = original dimensions, optimized).
const galleryItems = await Promise.all(
  (await getCollection("gallery")).map(async (item) => {
    const meta = item.data.image;
    // Served URL for the lightbox + anchor href; intrinsic dims for PhotoSwipe.
    const optimized = await getImage({ src: meta });
    return {
      id: item.id,
      alt: item.data.alt || item.data.name || "",
      width: meta.width,
      height: meta.height,
      href: optimized.src,
      image: meta,
    };
  }),
);
---

<SiteLayout pageContent={pageContent}>
  <section class="gallery-section">
    <div class="content-wrapper">
      <header class="gallery-header">
        <h1>Gallery</h1>
        <p>Selected builds from our garage.</p>
      </header>
      <div class="masonry" data-masonry data-gallery>
        {
          galleryItems.map((item) => (
            <div class="masonry-item">
              <a
                href={item.href}
                class="gallery-item"
                data-pswp-width={item.width}
                data-pswp-height={item.height}
                aria-label={item.alt}
              >
                <Image
                  src={item.image}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .gallery-section {
    padding: 80px 0 100px;
  }
  .gallery-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .gallery-header h1 {
    font-family: var(--font-families--accent-font);
    font-size: var(--desktop-heading-sizes--h1);
    color: var(--colors--ivory);
    margin-bottom: 12px;
  }
  .gallery-header p {
    color: var(--colors--slate);
    max-width: 560px;
    margin: 0 auto;
  }
  /* Frame the grid: cap width + center, instead of edge-to-edge */
  .masonry {
    max-width: 1160px;
    margin: 0 auto;
  }
  .masonry-item {
    width: 33.333%;
    /* Horizontal gap: padded inside the item so masonry's column math stays
       exact (no `gutter` option — a px gutter fights percentage widths). */
    padding: 0 10px;
    margin-bottom: 20px;
  }
  .masonry-item a {
    display: block;
  }
  .masonry-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .masonry-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
  }
  @media (max-width: 991px) {
    .masonry-item {
      width: 50%;
    }
  }
  @media (max-width: 639px) {
    .masonry-item {
      width: 100%;
    }
  }
</style>

<script>
  import Masonry from "masonry-layout";
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/dist/photoswipe.css";

  const grid = document.querySelector("[data-masonry]");
  if (grid) {
    const msnry = new Masonry(grid, {
      itemSelector: ".masonry-item",
      columnWidth: ".masonry-item",
      percentPosition: true,
    });
    let t: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener("resize", () => {
      clearTimeout(t);
      t = setTimeout(() => msnry.layout(), 100);
    });
  }

  const lightbox = new PhotoSwipeLightbox({
    gallery: "[data-gallery]",
    children: "a",
    pswpModule: () => import("photoswipe"),
  });
  lightbox.init();
</script>
